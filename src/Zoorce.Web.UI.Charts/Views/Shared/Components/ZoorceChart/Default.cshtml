@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Serialization
@using Zoorce.Web.UI.Charts
@model ZoorceChartOptions
@{
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    jsonOptions.Converters.Add(new JsonStringEnumConverter());
    var configuration = JsonSerializer.Serialize(new
    {
        kind = Model.Kind,
        size = Model.Size,
        barMode = Model.BarMode,
        areaMode = Model.AreaMode,
        curve = Model.Curve,
        appearance = Model.Appearance,
        header = Model.Header,
        legend = Model.Legend,
        tooltip = Model.Tooltip,
        showLegend = Model.ShowLegend,
        showGrid = Model.ShowGrid,
        showAxes = Model.ShowAxes,
        showTooltip = Model.ShowTooltip,
        minimumValue = Model.MinimumValue,
        maximumValue = Model.MaximumValue,
        targetValue = Model.TargetValue,
        donutInnerRadius = Model.DonutInnerRadius,
        valueSuffix = Model.ValueSuffix,
        binding = Model.Binding,
        series = Model.Series,
        ohlcPoints = Model.OhlcPoints,
        boxPlotPoints = Model.BoxPlotPoints,
        treemapItems = Model.TreemapItems,
        sankeyNodes = Model.SankeyNodes,
        sankeyLinks = Model.SankeyLinks,
        ganttItems = Model.GanttItems
    }, jsonOptions);
    var firstSeries = Model.Series.FirstOrDefault();
    var latestValue = firstSeries?.Points.LastOrDefault()?.Value;
    decimal? previousValue = firstSeries is { Points.Count: > 1 } ? firstSeries.Points[^2].Value : null;
    decimal? change = latestValue is not null && previousValue is not null ? latestValue.Value - previousValue.Value : null;
    string DisplayValue(decimal? value) => value is null ? "—" : value.Value % 1 == 0 ? value.Value.ToString("0", CultureInfo.InvariantCulture) : value.Value.ToString("0.##", CultureInfo.InvariantCulture);
    string DisplayWithSuffix(decimal? value)
    {
        var suffix = Model.ValueSuffix ?? string.Empty;
        return $"{DisplayValue(value)}{(suffix.Length > 0 && char.IsLetter(suffix[0]) ? " " : string.Empty)}{suffix}";
    }
}
<section id="@Model.Id" class="z-component z-chart-component @(Model.Appearance.CssClass ?? string.Empty)" data-z-chart data-z-chart-kind="@Model.Kind" data-z-chart-size="@Model.Size" data-z-chart-surface="@Model.Appearance.Surface" aria-label="@Model.Summary">
    <script type="application/json" data-z-chart-config>@Html.Raw(configuration)</script>
    @if (Model.Header.Visible)
    {
    <div class="z-chart-component-header">
        <div class="z-chart-copy"><p class="z-card-title">@Model.Title</p><p class="z-card-caption">@Model.Summary</p></div>
        @if (Model.Header.ShowMetric)
        {
        <div class="z-chart-metric" aria-live="polite"><strong data-z-chart-metric>@DisplayWithSuffix(latestValue)</strong><span data-z-chart-delta class="@(change is > 0 ? "is-positive" : change is < 0 ? "is-negative" : string.Empty)">@(change is null ? "Awaiting data" : $"{(change >= 0 ? "+" : string.Empty)}{DisplayWithSuffix(change)} vs. previous")</span></div>
        }
    </div>
    }
    <div class="z-chart-legend" data-z-chart-legend aria-label="Toggle data series" @((Model.ShowLegend && Model.Legend.Visible) ? null : "hidden")></div>
    <div class="z-chart-visual" data-z-chart-visual>
        <svg class="z-native-chart" data-z-chart-canvas role="img" aria-label="@Model.Summary" focusable="false" shape-rendering="geometricPrecision" text-rendering="geometricPrecision">
            <title>@Model.Title</title>
            <desc>@Model.Summary</desc>
        </svg>
        <div class="z-chart-tooltip" data-z-chart-tooltip role="status" aria-live="polite" hidden></div>
        <span class="z-component-state z-chart-live-state" data-z-chart-state aria-live="polite"></span>
    </div>
    <noscript>
        <div class="z-chart-noscript"><span>Interactive chart data</span><table><caption>@Model.Summary</caption><tbody>
        @foreach (var series in Model.Series)
        {
            @foreach (var point in series.Points)
            {
                <tr><th scope="row">@point.Label</th><td>@point.Value</td><td>@series.Name</td></tr>
            }
        }
        </tbody></table></div>
    </noscript>
    <table class="z-visually-hidden"><caption>@Model.Summary</caption><tbody>
        @foreach (var series in Model.Series)
        {
            @foreach (var point in series.Points)
            {
                <tr><th scope="row">@point.Label</th><td>@point.Value</td><td>@series.Name</td></tr>
            }
        }
    </tbody></table>
</section>
