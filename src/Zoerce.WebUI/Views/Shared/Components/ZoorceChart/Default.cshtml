@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Serialization
@using Zoerce.WebUI.Components.Charts
@model ZoorceChartOptions
@{
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    jsonOptions.Converters.Add(new JsonStringEnumConverter());
    var configuration = JsonSerializer.Serialize(new { kind = Model.Kind, size = Model.Size, valueSuffix = Model.ValueSuffix, sourceUrl = Model.SourceUrl, realtimeHubUrl = Model.RealtimeHubUrl, realtimeEventName = Model.RealtimeEventName, series = Model.Series }, jsonOptions);
    var firstSeries = Model.Series.FirstOrDefault();
    var coordinates = firstSeries is null ? [] : ZoorceChartGeometry.Normalize(firstSeries.Points);
    var polyline = string.Join(" ", coordinates.Select(point => $"{(44m + point.X * 5.28m).ToString(CultureInfo.InvariantCulture)},{(202m - point.Y * 1.76m).ToString(CultureInfo.InvariantCulture)}"));
    var latestValue = firstSeries?.Points.LastOrDefault()?.Value;
    decimal? previousValue = firstSeries is { Points.Count: > 1 } ? firstSeries.Points[^2].Value : (decimal?)null;
    decimal? change = latestValue is not null && previousValue is not null ? latestValue.Value - previousValue.Value : (decimal?)null;
    string DisplayValue(decimal? value) => value is null ? "—" : value.Value % 1 == 0 ? value.Value.ToString("0", CultureInfo.InvariantCulture) : value.Value.ToString("0.##", CultureInfo.InvariantCulture);
}
<section id="@Model.Id" class="z-component z-chart-component" data-z-chart data-z-chart-kind="@Model.Kind" data-z-chart-size="@Model.Size" aria-label="@Model.Summary">
    <script type="application/json" data-z-chart-config>@Html.Raw(configuration)</script>
    <div class="z-chart-component-header">
        <div class="z-chart-copy"><p class="z-card-title">@Model.Title</p><p class="z-card-caption">@Model.Summary</p></div>
        <div class="z-chart-metric" aria-live="polite"><strong data-z-chart-metric>@DisplayValue(latestValue)@Model.ValueSuffix</strong><span data-z-chart-delta class="@(change is > 0 ? "is-positive" : change is < 0 ? "is-negative" : string.Empty)">@(change is null ? "Awaiting data" : $"{(change >= 0 ? "+" : string.Empty)}{DisplayValue(change)} vs. previous")</span></div>
    </div>
    <div class="z-chart-legend" data-z-chart-legend aria-label="Series legend">
        @foreach (var series in Model.Series)
        {
            <span><i aria-hidden="true"></i>@series.Name</span>
        }
    </div>
    <div class="z-chart-visual">
        <svg class="z-native-chart" data-z-chart-canvas viewBox="0 0 600 250" preserveAspectRatio="none" role="img" aria-label="@Model.Summary">
            <title>@Model.Title</title>
            <desc>@Model.Summary</desc>
            <path class="z-native-chart-grid" d="M44 24H572M44 68H572M44 112H572M44 156H572M44 202H572" />
        <polyline class="z-native-chart-line" data-z-chart-line points="@polyline" />
        </svg>
        <span class="z-component-state z-chart-live-state" data-z-chart-state aria-live="polite"></span>
    </div>
    <table class="z-visually-hidden"><caption>@Model.Summary</caption><tbody>
        @foreach (var series in Model.Series)
        {
            @foreach (var point in series.Points)
            {
                <tr><th scope="row">@point.Label</th><td>@point.Value</td><td>@series.Name</td></tr>
            }
        }
    </tbody></table>
</section>
