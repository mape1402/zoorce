@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Serialization
@using Zoerce.WebUI.Components.Diagrams
@model ZoorceDiagramOptions
@{
    var serializerOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    serializerOptions.Converters.Add(new JsonStringEnumConverter());
    var configuration = JsonSerializer.Serialize(new
    {
        profile = Model.Profile,
        mode = Model.Mode,
        layout = Model.Layout,
        document = Model.Document,
        sourceUrl = Model.SourceUrl,
        saveUrl = Model.SaveUrl,
        validateUrl = Model.ValidateUrl,
        realtimeHubUrl = Model.RealtimeHubUrl,
        realtimeEventName = Model.RealtimeEventName,
        showPalette = Model.ShowPalette,
        showInspector = Model.ShowInspector,
        showMinimap = Model.ShowMinimap,
        panMode = Model.PanMode,
        snapToGrid = Model.SnapToGrid,
        gridSize = Model.GridSize,
        minimumZoom = Model.MinimumZoom,
        maximumZoom = Model.MaximumZoom,
        initialZoom = Model.InitialZoom
    }, serializerOptions);
    var isEditor = Model.Mode == ZoorceDiagramMode.Editor;
    var palette = Model.Profile switch
    {
        ZoorceDiagramProfile.MindMap => new[]
        {
            (ZoorceDiagramNodeKinds.Root, "Root", "✦"),
            (ZoorceDiagramNodeKinds.Branch, "Branch", "↗"),
            (ZoorceDiagramNodeKinds.Topic, "Topic", "◌"),
            (ZoorceDiagramNodeKinds.Note, "Note", "⌁")
        },
        ZoorceDiagramProfile.OrgChart => new[]
        {
            (ZoorceDiagramNodeKinds.Person, "Person", "●"),
            (ZoorceDiagramNodeKinds.Team, "Team", "◇"),
            (ZoorceDiagramNodeKinds.Vacancy, "Vacancy", "+")
        },
        ZoorceDiagramProfile.Architecture => new[]
        {
            (ZoorceDiagramNodeKinds.User, "User", "◉"),
            (ZoorceDiagramNodeKinds.Service, "Service", "▤"),
            (ZoorceDiagramNodeKinds.Database, "Data store", "◒"),
            (ZoorceDiagramNodeKinds.Queue, "Queue", "≈"),
            (ZoorceDiagramNodeKinds.External, "External", "↗"),
            (ZoorceDiagramNodeKinds.Boundary, "Boundary", "□")
        },
        _ => new[]
        {
            (ZoorceDiagramNodeKinds.Start, "Start", "●"),
            (ZoorceDiagramNodeKinds.Process, "Process", "▭"),
            (ZoorceDiagramNodeKinds.Decision, "Decision", "◇"),
            (ZoorceDiagramNodeKinds.InputOutput, "Input / output", "▱"),
            (ZoorceDiagramNodeKinds.Document, "Document", "▤"),
            (ZoorceDiagramNodeKinds.DataStore, "Data", "◒"),
            (ZoorceDiagramNodeKinds.End, "End", "■")
        }
    };
    string Coordinate(decimal value) => value.ToString(CultureInfo.InvariantCulture);
}
<section id="@Model.Id" class="z-component z-diagram" data-z-diagram data-z-diagram-profile="@Model.Profile" data-z-diagram-mode="@Model.Mode" aria-label="@Model.Summary">
    <script type="application/json" data-z-diagram-config>@Html.Raw(configuration)</script>
    <header class="z-diagram-header">
        <div><span class="z-section-kicker">@Model.Profile diagram</span><h2>@Model.Title</h2><p>@Model.Summary</p></div>
        <div class="z-diagram-state"><span data-z-diagram-status aria-live="polite">Ready</span><span class="z-badge z-badge-primary" data-z-diagram-dirty hidden>Unsaved</span></div>
    </header>

    <div class="z-diagram-toolbar" aria-label="Diagram controls">
        <div class="z-button-group z-diagram-toolbar-actions">
            @if (isEditor)
            {
                <button class="z-icon-button" type="button" data-z-diagram-command="undo" data-z-tooltip="Undo last change" aria-label="Undo last change"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 7 4 12l5 5" /><path d="M4 12h10a6 6 0 0 1 6 6" /></svg></button>
                <button class="z-icon-button" type="button" data-z-diagram-command="redo" data-z-tooltip="Redo last change" aria-label="Redo last change"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 7 5 5-5 5" /><path d="M20 12H10a6 6 0 0 0-6 6" /></svg></button>
            }
        </div>
        <div class="z-button-group z-diagram-toolbar-zoom" aria-label="Canvas zoom controls">
            <button class="z-icon-button" type="button" data-z-diagram-command="zoom-out" data-z-tooltip="Zoom out" aria-label="Zoom out"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.5" /><path d="m16 16 4.5 4.5M8 10.8h5.6" /></svg></button>
            <label class="z-diagram-zoom-input" data-z-tooltip="Set zoom percentage. Press Enter to apply."><input type="number" inputmode="decimal" min="@Coordinate(Model.MinimumZoom * 100)" max="@Coordinate(Model.MaximumZoom * 100)" step="1" value="100" data-z-diagram-zoom aria-label="Set zoom percentage" /><span aria-hidden="true">%</span></label>
            <button class="z-icon-button" type="button" data-z-diagram-command="zoom-in" data-z-tooltip="Zoom in" aria-label="Zoom in"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.5" /><path d="m16 16 4.5 4.5M8 10.8h5.6M10.8 8v5.6" /></svg></button>
            <button class="z-icon-button" type="button" data-z-diagram-command="fit" data-z-tooltip="Fit diagram to canvas" aria-label="Fit diagram to canvas"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M21 16v5h-5M3 16v5h5" /><path d="M7 7h10v10H7z" /></svg></button>
            <button class="z-icon-button" type="button" data-z-diagram-command="toggle-wheel-zoom" data-z-diagram-wheel-zoom-toggle data-z-tooltip="Enable scroll zoom" aria-pressed="false" aria-label="Enable scroll zoom"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="3" width="10" height="18" rx="5" /><path d="M12 3v6m0 3v3m-3 0h6" /></svg></button>
            @if (Model.ShowMinimap)
            {
                <button class="z-icon-button" type="button" data-z-diagram-command="toggle-overview" data-z-diagram-overview-toggle data-z-tooltip="Show diagram overview" aria-pressed="false" aria-label="Show diagram overview"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2" /><path d="M7 15.5 10 12l2.3 1.9 3.7-4 1 1.1" /><circle cx="8" cy="8.5" r="1" /></svg></button>
            }
        </div>
        @if (isEditor)
        {
            <div class="z-button-group z-diagram-toolbar-save"><button class="z-icon-button" type="button" data-z-diagram-command="save" data-z-tooltip="Save now" aria-label="Save now"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h11l3 3v15H5z" /><path d="M8 3v6h8V3" /><path d="M8 21v-7h8v7" /></svg></button></div>
        }
        <div class="z-button-group z-diagram-toolbar-focus"><button class="z-icon-button" type="button" data-z-diagram-command="focus" data-z-diagram-focus-toggle data-z-tooltip="Focus canvas" aria-pressed="false" aria-label="Enter focus mode"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M21 16v5h-5M3 16v5h5" /></svg></button></div>
    </div>

    <div class="z-diagram-workbench">
        @if (isEditor && Model.ShowPalette)
        {
            <aside class="z-diagram-palette" aria-label="Diagram elements"><strong>Elements</strong><p>Click to add, or drag onto the canvas.</p><div>
                @foreach (var item in palette)
                {
                    <button type="button" draggable="true" data-z-diagram-add="@item.Item1"><i aria-hidden="true">@item.Item3</i><span>@item.Item2</span></button>
                }
            </div></aside>
        }

        <div class="z-diagram-stage" data-z-diagram-stage>
            <div class="z-diagram-canvas" data-z-diagram-canvas tabindex="0" role="region" aria-label="@Model.Summary. Use the diagram navigator to browse nodes with a keyboard." aria-describedby="@Model.Id-pan-help">
                <div class="z-diagram-world" data-z-diagram-world>
                    <svg class="z-diagram-edges" data-z-diagram-edges aria-hidden="true"><defs><marker id="@(Model.Id + "-arrow")" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" /></marker></defs></svg>
                    @foreach (var node in Model.Document.NodeList)
                    {
                        <article class="z-diagram-node z-diagram-node--@node.Kind" data-z-diagram-node data-z-diagram-node-id="@node.Id" data-z-diagram-node-kind="@node.Kind" tabindex="0" role="button" aria-label="@node.Title" style="--z-node-x:@Coordinate(node.Position.X)px;--z-node-y:@Coordinate(node.Position.Y)px">
                            <button type="button" class="z-diagram-port z-diagram-port--in" data-z-diagram-port="in" aria-label="Connect into @node.Title" tabindex="@(isEditor ? "0" : "-1")"></button>
                            <div class="z-diagram-node-icon" aria-hidden="true"></div><div class="z-diagram-node-copy"><strong>@node.Title</strong>@if (!string.IsNullOrWhiteSpace(node.Description)){<small>@node.Description</small>}</div>
                            <button type="button" class="z-diagram-port z-diagram-port--out" data-z-diagram-port="out" aria-label="Connect from @node.Title" tabindex="@(isEditor ? "0" : "-1")"></button>
                        </article>
                    }
                </div>
                @if (Model.ShowMinimap)
                {
                    <aside class="z-diagram-overview" data-z-diagram-overview aria-label="Diagram overview" hidden>
                        <header><strong>Overview</strong><button class="z-icon-button" type="button" data-z-diagram-command="toggle-overview" aria-label="Hide diagram overview">×</button></header>
                        <button class="z-diagram-minimap" type="button" data-z-diagram-minimap aria-label="Diagram overview. Click or drag the viewport frame to navigate."></button>
                    </aside>
                }
                <span class="z-visually-hidden" data-z-diagram-announcer aria-live="polite"></span>
                <span id="@Model.Id-pan-help" class="z-visually-hidden" data-z-diagram-pan-help>Drag unused canvas space to pan the viewport.</span>
            </div>
        </div>

        @if (isEditor && Model.ShowInspector)
        {
            <aside class="z-diagram-inspector" data-z-diagram-inspector aria-label="Selected element inspector"><div data-z-diagram-inspector-empty><strong>Inspector</strong><p>Select a node or connection to edit its details.</p></div></aside>
        }
    </div>

    <footer class="z-diagram-footer">
        <div><strong>Diagram navigator</strong><span>Keyboard-friendly element list</span></div>
        <ol data-z-diagram-navigator>
            @foreach (var node in Model.Document.NodeList)
            {
                <li><button type="button" data-z-diagram-navigate="@node.Id">@node.Title</button></li>
            }
        </ol>
    </footer>
    <noscript><div class="z-diagram-noscript"><strong>@Model.Title</strong><ol>@foreach (var node in Model.Document.NodeList){<li>@node.Title (@node.Kind)</li>}</ol></div></noscript>
</section>
