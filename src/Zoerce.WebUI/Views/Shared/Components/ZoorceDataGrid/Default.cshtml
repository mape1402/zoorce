@using System.Text.Json
@using System.Text.Json.Serialization
@using Zoerce.WebUI.Abstractions.Data
@using Zoerce.WebUI.Components.DataGrid
@model ZoorceDataGridOptions
@{
    var serializerOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    serializerOptions.Converters.Add(new JsonStringEnumConverter());
    var configuration = JsonSerializer.Serialize(new
    {
        sourceUrl = Model.SourceUrl,
        loadMode = Model.LoadMode,
        pageSize = Model.PageSize,
        columns = Model.Columns,
        realtimeHubUrl = Model.RealtimeHubUrl,
        realtimeEventName = Model.RealtimeEventName,
        virtualize = Model.Virtualize
    }, serializerOptions);
    string? ValueFor(IReadOnlyDictionary<string, string?> item, string field) => item.TryGetValue(field, out var value) ? value : null;
}
<section id="@Model.Id" class="z-component z-data-grid-component" data-z-data-grid aria-label="@Model.AriaLabel">
    <script type="application/json" data-z-grid-config>@Html.Raw(configuration)</script>
    <div class="z-toolbar">
        @if (Model.EnableSearch)
        {
            <label class="z-search-field"><span aria-hidden="true">⌕</span><input type="search" data-z-grid-search aria-label="Search @Model.AriaLabel" placeholder="Search..." autocomplete="off" /></label>
        }
        <span class="z-component-state" data-z-grid-state aria-live="polite"></span>
    </div>
    <div class="z-data-shell">
        <table class="z-data-grid">
            <thead><tr>
                @foreach (var column in Model.Columns)
                {
                    <th scope="col">
                        @if (column.Sortable)
                        {
                            <button type="button" data-z-grid-sort="@column.Field" aria-sort="none">@column.Title <span aria-hidden="true">↕</span></button>
                        }
                        else
                        {
                            @column.Title
                        }
                    </th>
                }
            </tr></thead>
            <tbody data-z-grid-body>
                @foreach (var item in Model.InitialItems)
                {
                    <tr>
                        @foreach (var column in Model.Columns)
                        {
                            <td>@ValueFor(item, column.Field)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        <div class="z-grid-empty" data-z-grid-empty hidden>No matching records.</div>
        <div class="z-pagination" data-z-grid-pagination>
            <span data-z-grid-summary>Showing @Model.InitialItems.Count@(Model.InitialTotalCount is int total ? $" of {total}" : string.Empty)</span>
            <div class="z-pagination-actions">
                <button type="button" data-z-grid-previous aria-label="Previous page">←</button>
                <button type="button" data-z-grid-next aria-label="Next page">→</button>
            </div>
        </div>
        <div class="z-grid-sentinel" data-z-grid-sentinel hidden aria-hidden="true"></div>
        <button type="button" class="z-button z-button-ghost z-grid-load-more" data-z-grid-load-more hidden>Load more</button>
    </div>
</section>
