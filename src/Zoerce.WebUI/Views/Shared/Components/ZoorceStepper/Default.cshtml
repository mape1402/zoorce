@using System.Text.Json
@using System.Text.Json.Serialization
@using Zoerce.WebUI.Components.Stepper
@model ZoorceStepperOptions
@{
    var serializerOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    serializerOptions.Converters.Add(new JsonStringEnumConverter());
    var configuration = JsonSerializer.Serialize(new
    {
        currentStepId = Model.CurrentStepId,
        variant = Model.Variant,
        orientation = Model.Orientation,
        interaction = Model.Interaction,
        allowCompletedNavigation = Model.AllowCompletedNavigation,
        allowFutureNavigation = Model.AllowFutureNavigation,
        presentation = Model.Presentation,
        transitionRules = Model.TransitionRules,
        transitionUrl = Model.TransitionUrl,
        sourceUrl = Model.SourceUrl,
        realtimeHubUrl = Model.RealtimeHubUrl,
        realtimeEventName = Model.RealtimeEventName,
        realtimeTransport = Model.RealtimeTransport
    }, serializerOptions);
    var currentIndex = Model.Steps.ToList().FindIndex(step => string.Equals(step.Id, Model.CurrentStepId, StringComparison.OrdinalIgnoreCase));
    var rootClasses = $"z-component z-stepper z-stepper--{Model.Variant.ToString().ToLowerInvariant()} z-stepper--{Model.Density.ToString().ToLowerInvariant()}";
    string StateText(ZoorceStepperStep step) => step.StatusText ?? step.State switch
    {
        ZoorceStepperState.Active => "In progress",
        ZoorceStepperState.Completed => "Completed",
        ZoorceStepperState.Attention => "Needs review",
        ZoorceStepperState.Error => "Action required",
        ZoorceStepperState.Disabled => "Unavailable",
        _ => "Pending"
    };
}
<section id="@Model.Id" class="@rootClasses" data-z-stepper data-z-stepper-variant="@Model.Variant" data-z-stepper-orientation="@Model.Orientation" data-z-stepper-current="@Model.CurrentStepId" data-z-stepper-show-connectors="@Model.ShowConnector.ToString().ToLowerInvariant()" data-z-stepper-marker-style="@Model.Presentation.MarkerStyle" data-z-stepper-active-indicator="@Model.Presentation.ActiveIndicator" data-z-stepper-active-motion="@Model.Presentation.ActiveMotion" data-z-stepper-label-placement="@Model.Presentation.LabelPlacement" data-z-stepper-connector-style="@Model.Presentation.ConnectorStyle" style="--z-step-count:@Model.Steps.Count" aria-label="@Model.AriaLabel">
    <script type="application/json" data-z-stepper-config>@Html.Raw(configuration)</script>
    <nav class="z-stepper-nav" aria-label="@Model.AriaLabel">
        <ol class="z-stepper-list" data-z-stepper-list>
            @for (var index = 0; index < Model.Steps.Count; index++)
            {
                var step = Model.Steps[index];
                var isCurrent = index == currentIndex;
                var isDisabled = step.State == ZoorceStepperState.Disabled || !step.IsNavigable;
                var stepClasses = $"z-stepper-step is-{step.State.ToString().ToLowerInvariant()}" + (step.Tone != ZoorceStepperTone.Auto ? $" has-tone tone-{step.Tone.ToString().ToLowerInvariant()}" : string.Empty) + (isCurrent ? " is-current" : string.Empty);
                var markerText = Model.Presentation.MarkerStyle switch
                {
                    ZoorceStepperMarkerStyle.None or ZoorceStepperMarkerStyle.Dot => null,
                    ZoorceStepperMarkerStyle.Number => Model.ShowNumbers ? (index + 1).ToString() : null,
                    ZoorceStepperMarkerStyle.Icon => step.Icon ?? (Model.ShowNumbers ? (index + 1).ToString() : null),
                    ZoorceStepperMarkerStyle.Check when step.State == ZoorceStepperState.Completed => "✓",
                    ZoorceStepperMarkerStyle.Check => step.Icon ?? (Model.ShowNumbers ? (index + 1).ToString() : null),
                    _ when step.State == ZoorceStepperState.Completed => "✓",
                    _ when !string.IsNullOrWhiteSpace(step.Icon) => step.Icon,
                    _ when Model.ShowNumbers => (index + 1).ToString(),
                    _ => null
                };
                <li class="@stepClasses" data-z-stepper-step data-z-step-id="@step.Id" data-z-step-state="@step.State" data-z-step-tone="@step.Tone" data-z-step-index="@index" data-z-step-navigable="@step.IsNavigable.ToString().ToLowerInvariant()" data-z-step-optional="@step.IsOptional.ToString().ToLowerInvariant()" data-z-step-target-url="@step.TargetUrl" style="--z-step-order:@(Model.Steps.Count - index)">
                    @if (Model.Interaction == ZoorceStepperInteraction.Progress)
                    {
                        <span class="z-stepper-trigger" data-z-stepper-trigger aria-current="@(isCurrent ? "step" : null)">
                            <span class="z-stepper-marker" data-z-stepper-marker data-z-stepper-marker-default="@markerText" aria-hidden="true">
                                @if (markerText is not null)
                                {
                                    <span>@markerText</span>
                                }
                            </span>
                            <span class="z-stepper-copy"><strong data-z-stepper-title>@step.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(step.SupportingText))
                                {
                                    <small data-z-stepper-supporting>@step.SupportingText</small>
                                }
                                @if (Model.ShowStatus)
                                {
                                    <em data-z-stepper-status>@(step.IsOptional ? "Optional" : StateText(step))</em>
                                }
                            </span>
                        </span>
                    }
                    else
                    {
                        <button class="z-stepper-trigger" type="button" data-z-stepper-trigger aria-current="@(isCurrent ? "step" : null)" aria-controls="@step.PanelId" aria-disabled="@isDisabled.ToString().ToLowerInvariant()" tabindex="@(isCurrent ? "0" : "-1")" @(isDisabled ? "disabled" : null)>
                            <span class="z-stepper-marker" data-z-stepper-marker data-z-stepper-marker-default="@markerText" aria-hidden="true">
                                @if (markerText is not null)
                                {
                                    <span>@markerText</span>
                                }
                            </span>
                            <span class="z-stepper-copy"><strong data-z-stepper-title>@step.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(step.SupportingText))
                                {
                                    <small data-z-stepper-supporting>@step.SupportingText</small>
                                }
                                @if (Model.ShowStatus)
                                {
                                    <em data-z-stepper-status>@(step.IsOptional ? "Optional" : StateText(step))</em>
                                }
                            </span>
                        </button>
                    }
                </li>
            }
        </ol>
    </nav>
    @if (Model.Interaction == ZoorceStepperInteraction.Wizard)
    {
        <div class="z-stepper-actions" data-z-stepper-actions>
            <button type="button" class="z-button z-button-ghost z-stepper-previous" data-z-stepper-previous>@Model.PreviousLabel</button>
            <button type="button" class="z-button z-button-primary z-stepper-next" data-z-stepper-next data-z-stepper-next-label="@Model.NextLabel" data-z-stepper-complete-label="@Model.CompleteLabel">@Model.NextLabel</button>
        </div>
    }
    <p class="z-visually-hidden" data-z-stepper-live aria-live="polite"></p>
    <noscript><p class="z-stepper-noscript">@Model.AriaLabel: @Model.Steps[currentIndex].Title</p></noscript>
</section>
