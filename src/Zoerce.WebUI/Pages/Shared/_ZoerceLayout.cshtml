@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@using Zoerce.WebUI.Abstractions.Navigation
@using Zoerce.WebUI.Abstractions.Notifications
@using Zoerce.WebUI.Abstractions.UserContext
@using Zoerce.WebUI.Options
@inject IOptions<ZoerceWebUiOptions> ZoerceOptions
@inject INavigationProvider NavigationProvider
@inject IUserMenuProvider UserMenuProvider
@inject IToastService Toasts
@{
    var options = ZoerceOptions.Value;
    var navigation = NavigationProvider.GetItems();
    var profile = UserMenuProvider.GetCurrentUser();
    var notifications = Toasts.Drain();
    var pageTitle = ViewData["Title"]?.ToString() ?? options.ApplicationName;
    var initials = string.IsNullOrWhiteSpace(profile?.DisplayName)
        ? options.BrandMark
        : profile!.DisplayName[..1].ToUpperInvariant();
    var defaultTheme = options.DefaultTheme == ZoorceThemeMode.Light ? "light" : "dark";
    var sidebarMode = options.SidebarMode.ToString().ToLowerInvariant();
    var sidebarDefault = options.SidebarCollapsedByDefault ? "collapsed" : "expanded";
    var navigationDensity = options.NavigationDensity.ToString().ToLowerInvariant();

    IEnumerable<NavigationItem> GetLeafNavigationItems(IEnumerable<NavigationItem> items)
    {
        foreach (var item in items)
        {
            if (item.HasChildren)
            {
                foreach (var child in GetLeafNavigationItems(item.Children!))
                {
                    yield return child;
                }
            }
            else if (!string.IsNullOrWhiteSpace(item.Url))
            {
                yield return item;
            }
        }
    }
}
<!DOCTYPE html>
<html lang="en" data-zoerce-theme="@defaultTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <title>@pageTitle · @options.ApplicationName</title>
    <script>
        (() => {
            const stored = localStorage.getItem("zoerce-theme");
            const fallback = document.documentElement.dataset.zoerceTheme;
            document.documentElement.dataset.zoerceTheme = stored === "light" || stored === "dark" ? stored : fallback;
        })();
    </script>
    <style>@Html.Raw(options.ToCssThemeRules())</style>
    <link rel="stylesheet" href="~/_content/Zoerce.WebUI/css/zoerce.css" asp-append-version="true" />
</head>
<body>
    <a class="z-skip-link" href="#main-content">Skip to content</a>
    <div class="z-app-shell" data-z-shell data-sidebar-mode="@sidebarMode" data-sidebar-default="@sidebarDefault" data-sidebar-persist="@options.PersistSidebarState.ToString().ToLowerInvariant()" data-navigation-density="@navigationDensity">
        <aside class="z-sidebar" id="zoerce-sidebar" data-z-sidebar aria-label="Primary navigation">
            <div class="z-sidebar-brand">
                <a class="z-brand" href="/" aria-label="@options.ApplicationName home">
                    <span class="z-brand-mark" aria-hidden="true">@options.BrandMark</span>
                    <span class="z-brand-copy">
                        <strong>@options.ApplicationName</strong>
                        <small>Design system</small>
                    </span>
                </a>
                <button class="z-icon-button z-sidebar-close" type="button" data-z-sidebar-close aria-label="Close navigation">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
            </div>

            <nav class="z-nav">
                <p class="z-nav-label">Workspace</p>
                @await Html.PartialAsync("_ZoerceNavigation", navigation, new ViewDataDictionary(ViewData)
                {
                    ["ZoorceNavigationDepth"] = 0,
                    ["ZoorceNavigationPath"] = "root"
                })
            </nav>

            <div class="z-sidebar-footer">
                <div class="z-pro-status">
                    <span class="z-pro-orb" aria-hidden="true"></span>
                    <span><strong>All systems ready</strong><small>99.99% availability</small></span>
                </div>
            </div>
        </aside>
        <button class="z-sidebar-backdrop" type="button" data-z-sidebar-backdrop data-z-sidebar-close aria-label="Close navigation" hidden></button>

        <div class="z-page-shell">
            <header class="z-topbar">
                <div class="z-topbar-start">
                    <button class="z-icon-button z-sidebar-toggle" type="button" data-z-sidebar-toggle aria-label="Collapse navigation" aria-controls="zoerce-sidebar" aria-expanded="true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                    </button>
                    <div class="z-topbar-context">
                        <span class="z-eyebrow">Zoorce UI</span>
                        <span class="z-topbar-title">@pageTitle</span>
                    </div>
                </div>
                <div class="z-topbar-actions">
                    <button class="z-command-trigger" type="button" data-z-command-open aria-haspopup="dialog">
                        <span aria-hidden="true">⌕</span><span>Quick search</span><kbd>Ctrl K</kbd>
                    </button>
                    <button class="z-theme-toggle" type="button" data-z-theme-toggle aria-label="Switch color mode" aria-pressed="@(defaultTheme == "dark" ? "true" : "false")">
                        <span class="z-theme-icon" aria-hidden="true">☼</span><span data-z-theme-label>Light</span>
                    </button>
                    @if (profile is not null)
                    {
                        <details class="z-user-menu">
                            <summary class="z-user-trigger" aria-label="Open user menu">
                                @if (!string.IsNullOrWhiteSpace(profile.AvatarUrl))
                                {
                                    <img src="@profile.AvatarUrl" alt="" />
                                }
                                else
                                {
                                    <span class="z-avatar">@initials</span>
                                }
                                <span class="z-user-copy"><strong>@profile.DisplayName</strong><small>@profile.Email</small></span>
                                <span aria-hidden="true">⌄</span>
                            </summary>
                            <div class="z-user-popover">
                                @foreach (var action in profile.Actions ?? [])
                                {
                                    <a href="@action.Url"><span aria-hidden="true">@action.Icon</span>@action.Text</a>
                                }
                            </div>
                        </details>
                    }
                </div>
            </header>

            <main class="z-main" id="main-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="z-toast-stack" data-z-toast-stack aria-live="polite" aria-atomic="false">
        @foreach (var toast in notifications)
        {
            <article class="z-toast z-toast-@toast.Kind.ToString().ToLowerInvariant()" data-z-toast-item data-z-timeout="@toast.DurationMilliseconds" role="status">
                <span class="z-toast-symbol" aria-hidden="true"></span>
                <div><strong>@toast.Title</strong><p>@toast.Message</p></div>
                <button type="button" class="z-toast-dismiss" data-z-toast-dismiss aria-label="Dismiss notification">×</button>
            </article>
        }
    </div>

    <div class="z-dialog-layer" data-z-dialog-layer hidden>
        <section class="z-dialog" role="dialog" aria-modal="true" aria-labelledby="z-dialog-title" tabindex="-1">
            <div class="z-dialog-icon" aria-hidden="true">?</div>
            <div class="z-dialog-copy"><h2 id="z-dialog-title">Confirm action</h2><p data-z-dialog-message>Are you sure?</p></div>
            <div class="z-dialog-actions"><button class="z-button z-button-ghost" type="button" data-z-dialog-cancel>Cancel</button><button class="z-button z-button-danger" type="button" data-z-dialog-confirm>Confirm</button></div>
        </section>
    </div>

    <div class="z-command-layer" data-z-command-layer hidden>
        <section class="z-command-palette" role="dialog" aria-modal="true" aria-labelledby="z-command-title">
            <h2 id="z-command-title" class="z-visually-hidden">Quick search</h2>
            <div class="z-command-search"><span aria-hidden="true">⌕</span><input data-z-command-input type="search" aria-label="Search pages and actions" placeholder="Search pages and actions..." autocomplete="off" /><kbd>Esc</kbd></div>
            <div class="z-command-list" data-z-command-list>
                @foreach (var item in GetLeafNavigationItems(navigation))
                {
                    <a class="z-command-item" href="@item.Url" data-z-command-item><span>@item.Icon</span><span>@item.Text</span><kbd>↵</kbd></a>
                }
            </div>
        </section>
    </div>

    <script src="~/_content/Zoerce.WebUI/js/zoerce.js" asp-append-version="true"></script>
    <script src="~/_content/Zoerce.WebUI/js/zoerce-charts.js" asp-append-version="true"></script>
    <script src="~/_content/Zoerce.WebUI/js/zoerce-stepper.js" asp-append-version="true"></script>
    <script src="~/_content/Zoerce.WebUI/js/zoerce-diagrams.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
