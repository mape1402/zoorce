<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <IsPackable>true</IsPackable>
    <PackageId>Zoerce.WebUI</PackageId>
    <Description>Reusable Razor Pages web shell and UI components for ASP.NET Core applications.</Description>
    <PackageTags>razor;razor-pages;web-ui;components;aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zoerce.WebUI.Abstractions\Zoerce.WebUI.Abstractions.csproj" />
  </ItemGroup>



</Project>
