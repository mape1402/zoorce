@model Zoorce.Web.UI.Navigation.Components.ZoorceTabsOptions
@{ var activeId = Model.Items.FirstOrDefault(item => item.Selected && !item.Disabled)?.Id ?? Model.Items.FirstOrDefault(item => !item.Disabled)?.Id; }
<div id="@Model.Id" class="z-tabs" data-z-tabs data-z-tabs-keep-mounted="@Model.KeepPanelsMounted.ToString().ToLowerInvariant()"><div class="z-tab-list" role="tablist">@foreach (var item in Model.Items) { var selected = item.Id == activeId; <button id="@($"{Model.Id}-{item.Id}-tab")" type="button" role="tab" aria-selected="@selected.ToString().ToLowerInvariant()" aria-controls="@($"{Model.Id}-{item.Id}-panel")" tabindex="@(selected ? "0" : "-1")" data-z-tab="@item.Id" disabled="@item.Disabled">@if (item.Icon is not null) { <i aria-hidden="true">@item.Icon</i> }<span>@item.Text</span>@if (item.Badge is not null) { <em>@item.Badge</em> }</button> }</div>@foreach (var item in Model.Items) { var selected = item.Id == activeId; <section id="@($"{Model.Id}-{item.Id}-panel")" role="tabpanel" aria-labelledby="@($"{Model.Id}-{item.Id}-tab")" hidden="@(!selected)" data-z-tab-panel="@item.Id">@item.Content</section> }</div>
