@using Zoorce.Web.UI.Navigation.Components
@model ZoorceTreeViewNodeModel
@{ var children = Model.Item.Children.Count > 0; }
<div class="z-tree-view-node" role="treeitem" aria-level="@Model.Level" aria-selected="@Model.Item.Selected.ToString().ToLowerInvariant()" aria-expanded="@(children ? Model.Item.Expanded.ToString().ToLowerInvariant() : null)">@if (children) { <button type="button" class="z-tree-view-expand @(Model.Item.Expanded ? "is-expanded" : string.Empty)" aria-label="Toggle @Model.Item.Text" data-z-tree-expand>›</button> } else { <span class="z-tree-view-spacer"></span> }<button type="button" class="z-tree-view-option @(Model.Item.Selected ? "is-selected" : string.Empty)" data-z-tree-value="@Model.Item.Value" disabled="@Model.Item.Disabled">@if (Model.Item.Icon is not null) { <i aria-hidden="true">@Model.Item.Icon</i> }<span>@Model.Item.Text</span></button>@if (children) { <div class="z-tree-view-children" role="group" hidden="@(!Model.Item.Expanded)">@foreach (var child in Model.Item.Children) { @await Html.PartialAsync("/Views/Shared/Components/ZoorceTreeView/_ZoorceTreeViewNode.cshtml", new ZoorceTreeViewNodeModel(child, Model.Multiple, Model.Level + 1)) }</div> }</div>
