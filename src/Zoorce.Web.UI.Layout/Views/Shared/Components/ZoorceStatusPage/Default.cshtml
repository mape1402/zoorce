@model Zoorce.Web.UI.Layout.Components.ZoorceStatusPageOptions
<main class="z-status-page @Model.CssClass">
    <div class="z-status-grid" aria-hidden="true"></div>
    @if (Model.ShowShootingStars) { <div class="z-status-streaks" aria-hidden="true"><span></span><span></span><span></span><span></span></div> }
    <header class="z-status-brand"><span>@Model.ApplicationName</span>@if (!string.IsNullOrWhiteSpace(Model.BrandSubtitle)) { <small>@Model.BrandSubtitle</small> }</header>
    <div class="z-status-layout">
        <section class="z-status-copy" aria-labelledby="z-status-title">
            <span class="z-status-code">@Model.StatusCode</span>
            <h1 id="z-status-title">@Model.Title</h1>
            <p>@Model.Description</p>
            @if (!string.IsNullOrWhiteSpace(Model.Details)) { <details class="z-status-details"><summary>@Model.DetailsLabel</summary><p>@Model.Details</p></details> }
            @Model.AdditionalContent
            @if (Model.Actions.Count > 0)
            {
                <nav class="z-status-actions" aria-label="Available actions">
                    @foreach (var action in Model.Actions) { <a class="z-status-action @(action.Secondary ? "z-status-action-secondary" : "")" href="@Url.Content(action.Url)">@action.Text <span aria-hidden="true">→</span></a> }
                </nav>
            }
        </section>
        @if (Model.ShowIllustration || !string.IsNullOrWhiteSpace(Model.Speech))
        {
            <div class="z-status-scene">
                @if (!string.IsNullOrWhiteSpace(Model.Speech)) { <div class="z-status-bubble">@Model.Speech</div> }
                @if (Model.ShowIllustration)
                {
                    @if (Model.IllustrationContent is not null) { <div class="z-status-custom-art">@Model.IllustrationContent</div> }
                    else
                    {
                        <svg class="z-status-astronaut" viewBox="0 0 400 430" aria-hidden="true" focusable="false">
                            <g class="z-status-orbit" fill="none" stroke="currentColor"><ellipse cx="200" cy="220" rx="175" ry="110" transform="rotate(-27 200 220)" stroke-opacity=".18" stroke-width="1.5" stroke-dasharray="5 9"/><circle cx="64" cy="250" r="4" fill="currentColor" stroke="none"/><circle cx="327" cy="133" r="5" fill="currentColor" stroke="none" opacity=".7"/></g>
                            <g class="z-status-astronaut-float" stroke-linejoin="round" stroke-linecap="round">
                                <path d="M139 209l-40 18-26 43 19 13 36-34 27-4 M261 209l40 18 26 43-19 13-36-34-27-4" fill="var(--z-status-suit)" stroke="var(--z-status-outline)" stroke-width="5"/>
                                <path d="M91 265c-13-4-21 3-22 13 1 10 12 15 22 10l10-12 M309 265c13-4 21 3 22 13-1 10-12 15-22 10l-10-12" fill="var(--z-status-suit)" stroke="var(--z-status-outline)" stroke-width="5"/>
                                <rect x="122" y="199" width="156" height="127" rx="48" fill="var(--z-status-suit)" stroke="var(--z-status-outline)" stroke-width="5"/>
                                <path d="M147 312l-6 51q-1 20 20 21h19l8-63 M253 312l6 51q1 20-20 21h-19l-8-63" fill="var(--z-status-suit)" stroke="var(--z-status-outline)" stroke-width="5"/>
                                <path d="M139 365h43v16q-5 11-25 10-21 0-24-10z M218 365h43l6 16q-3 10-24 10-20 1-25-10z" fill="var(--z-status-helmet)" stroke="var(--z-status-outline)" stroke-width="5"/>
                                <rect x="159" y="241" width="82" height="48" rx="10" fill="var(--z-status-helmet)" stroke="var(--z-status-outline)" stroke-width="4"/>
                                <circle cx="177" cy="258" r="5" fill="var(--z-status-accent)"/><path d="M190 257h32 M190 270h20" stroke="var(--z-status-outline)" stroke-width="4"/>
                                <path d="M150 211h100v15H150z" fill="var(--z-status-helmet)" stroke="var(--z-status-outline)" stroke-width="4"/>
                                <rect x="108" y="70" width="184" height="157" rx="72" fill="var(--z-status-suit)" stroke="var(--z-status-outline)" stroke-width="5"/>
                                <rect x="128" y="88" width="144" height="110" rx="51" fill="var(--z-status-visor)" stroke="var(--z-status-outline)" stroke-width="4"/>
                                <path d="M151 122q10-19 31-21 M152 140q1-5 3-9" fill="none" stroke="white" stroke-opacity=".48" stroke-width="6"/>
                                <path d="M185 159q15 12 30 0" fill="none" stroke="white" stroke-opacity=".8" stroke-width="4"/><circle cx="177" cy="141" r="4" fill="white"/><circle cx="223" cy="141" r="4" fill="white"/>
                                <path d="M132 201q68 24 136 0" fill="none" stroke="var(--z-status-outline)" stroke-width="4"/>
                            </g>
                        </svg>
                    }
                }
            </div>
        }
    </div>
</main>
