@using Microsoft.Extensions.Options
@using Zoorce.Web.UI.Layout
@using Zoorce.Web.UI.Theming
@using Zoorce.Web.UI.Foundation.WaitDialog
@using Zoorce.Web.UI.Layout.Components
@inject IOptions<ZoorceShellOptions> ZoorceOptions
@{
    var shell = ZoorceOptions.Value;
    var pageTitle = ViewData["Title"]?.ToString() ?? shell.ApplicationName;
    var defaultTheme = shell.DefaultTheme == ZoorceThemeMode.Light ? "light" : "dark";
    var sidebarMode = shell.SidebarMode.ToString().ToLowerInvariant();
    var sidebarDefault = shell.SidebarCollapsedByDefault ? "collapsed" : "expanded";
    var navigationDensity = shell.NavigationDensity.ToString().ToLowerInvariant();
    var navigationExpansion = shell.NavigationExpansion.ToString().ToLowerInvariant();
}
<!DOCTYPE html>
<html lang="en" data-zoorce-theme="@defaultTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <title>@pageTitle · @shell.ApplicationName</title>
    <script>
        (() => {
            const stored = localStorage.getItem("zoorce-theme");
            const fallback = document.documentElement.dataset.zoorceTheme;
            document.documentElement.dataset.zoorceTheme = stored === "light" || stored === "dark" ? stored : fallback;
        })();
    </script>
    <style>@Html.Raw(shell.ToCssThemeRules())</style>
    <link rel="stylesheet" href="~/_content/Zoorce.Web.UI/css/zoorce.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Zoorce.Web.UI.Foundation/css/zoorce-foundation-progress.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Zoorce.Web.UI.Foundation/css/zoorce-foundation-skeleton.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Zoorce.Web.UI.Foundation/css/zoorce-foundation-wait-dialog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Zoorce.Web.UI.Foundation/css/zoorce-foundation-tooltip.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Zoorce.Web.UI.Foundation/css/zoorce-foundation-controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Zoorce.Web.UI.Foundation/css/zoorce-foundation-progress-button.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Zoorce.Web.UI.Foundation/css/zoorce-foundation-surfaces.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Zoorce.Web.UI.Navigation/css/zoorce-navigation-controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Zoorce.Web.UI.Navigation/css/zoorce-navigation-extended.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Zoorce.Web.UI.Forms/css/zoorce-forms-advanced.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Zoorce.Web.UI.Forms/css/zoorce-date-picker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Zoorce.Web.UI.Forms/css/zoorce-time-picker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Zoorce.Web.UI.Layout/css/zoorce-split-pane.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Zoorce.Web.UI/css/zoorce-disclosure-icons.css" asp-append-version="true" />
</head>
<body>
    <a class="z-skip-link" href="#main-content">Skip to content</a>
    <div class="z-app-shell" data-z-shell data-sidebar-mode="@sidebarMode" data-sidebar-default="@sidebarDefault" data-sidebar-persist="@shell.PersistSidebarState.ToString().ToLowerInvariant()" data-navigation-density="@navigationDensity" data-navigation-expansion="@navigationExpansion" data-navigation-persist="@shell.PersistNavigationExpansion.ToString().ToLowerInvariant()">
        @await Component.InvokeAsync("ZoorceSidebarNavigation")
        <button class="z-sidebar-backdrop" type="button" data-z-sidebar-backdrop data-z-sidebar-close aria-label="Close navigation" hidden></button>
        <div class="z-page-shell">
            @await Component.InvokeAsync("ZoorceTopBar", new { title = pageTitle, back = ViewData["ZoorceTopBarBack"] as ZoorceTopBarBackOptions })
            <main class="z-main" id="main-content">@RenderBody()</main>
        </div>
    </div>
    @await Component.InvokeAsync("ZoorceToastRegion")
    @await Component.InvokeAsync("ZoorceConfirmationDialog")
    @await Component.InvokeAsync("ZoorceCommandPalette")
    @await Component.InvokeAsync("ZoorceWaitDialog", new ZoorceWaitDialogOptions { Id = "zoorce-wait-dialog" })
    <script src="~/_content/Zoorce.Web.UI.Layout/js/zoorce-layout.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Theming/js/zoorce-theme.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Data/js/zoorce-data.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Foundation/js/zoorce-foundation-wait-dialog.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Foundation/js/zoorce-foundation-controls.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Foundation/js/zoorce-foundation-surfaces.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.DataGrid/js/zoorce-data-grid.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Charts/js/zoorce-charts.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Navigation/js/zoorce-workflow-core.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Navigation/js/zoorce-stepper.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Navigation/js/zoorce-wizard.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Navigation/js/zoorce-navigation-controls.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Navigation/js/zoorce-navigation-extended.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Diagrams/js/zoorce-diagrams.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Forms/js/zoorce-forms.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Forms/js/controls/zoorce-select.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Forms/js/controls/zoorce-combobox.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Forms/js/controls/zoorce-rating.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Forms/js/controls/zoorce-advanced-selection.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Forms/js/zoorce-date-picker.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Forms/js/zoorce-time-picker.js" asp-append-version="true"></script>
    <script src="~/_content/Zoorce.Web.UI.Layout/js/zoorce-split-pane.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
