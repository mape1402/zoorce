@using System.Globalization
@model Zoorce.Web.UI.Foundation.Components.ZoorceProgressButtonOptions
@{
    var active = Model.IsIndeterminate || Model.Progress is > 0 and < 100;
    var progress = Model.Progress ?? 0;
    var state = Model.Disabled ? "disabled" : progress >= 100 ? "complete" : active ? "active" : "idle";
    var style = $"--z-button-progress:{progress.ToString(CultureInfo.InvariantCulture)}%;";
    if (Model.ActiveColor is not null) style += $"--z-progress-active:{Model.ActiveColor};";
    if (Model.ActiveForegroundColor is not null) style += $"--z-progress-active-foreground:{Model.ActiveForegroundColor};";
    if (Model.CompletionColor is not null) style += $"--z-progress-complete:{Model.CompletionColor};";
    if (Model.CompletionForegroundColor is not null) style += $"--z-progress-complete-foreground:{Model.CompletionForegroundColor};";
}
<button id="@Model.Id" class="z-progress-button z-progress-button-@Model.Tone z-progress-button-complete-@Model.CompletionTone" type="button" style="@style" disabled="@(Model.Disabled || (active && Model.DisableWhileActive))" aria-busy="@active.ToString().ToLowerInvariant()" data-z-progress-button data-z-progress-state="@state" data-z-progress-indeterminate="@Model.IsIndeterminate.ToString().ToLowerInvariant()">
    <span class="z-progress-button-fill" data-z-progress-fill aria-hidden="true"></span>
    <span class="z-progress-button-content">@if (Model.Icon is not null) { <i data-z-progress-icon aria-hidden="true">@Model.Icon</i> }<span data-z-progress-label>@Model.Text</span></span>
    <span class="z-visually-hidden" data-z-progress-value role="progressbar" aria-label="@Model.Text progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@(Model.Progress is null ? null : (int)Math.Round(progress))"></span>
</button>
