@model Zoorce.Web.UI.Foundation.Components.ZoorceDialogOptions
<div id="@Model.Id" class="z-dialog-layer z-component-dialog-layer" data-z-component-dialog data-z-dialog-backdrop="@Model.CloseOnBackdrop.ToString().ToLowerInvariant()" hidden><section class="z-component-dialog z-component-dialog-@Model.Size" role="dialog" aria-modal="true" aria-labelledby="@($"{Model.Id}-title")" tabindex="-1" data-z-dialog-focus><header><div><span class="z-section-kicker">Dialog</span><h2 id="@($"{Model.Id}-title")">@Model.Title</h2>@if (Model.Description is not null) { <p>@Model.Description</p> }</div><button type="button" class="z-icon-button" aria-label="Close dialog" data-z-dialog-close>×</button></header>@if (Model.Body is not null) { <div class="z-component-dialog-body">@Model.Body</div> }@if (Model.Footer is not null) { <footer>@Model.Footer</footer> }</section></div>
