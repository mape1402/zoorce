@model Zoorce.Web.UI.Foundation.Components.ZoorceCardOptions
<article id="@Model.Id" class="z-component-card @(Model.Interactive ? "is-interactive" : string.Empty)" role="@(Model.Interactive ? "button" : null)" tabindex="@(Model.Interactive ? "0" : null)" data-z-card="@(Model.Interactive ? string.Empty : null)">@if (Model.ImageUrl is not null) { <img class="z-component-card-media" src="@Model.ImageUrl" alt="" /> }@if (Model.Title is not null || Model.Description is not null) { <header><h2>@Model.Title</h2>@if (Model.Description is not null) { <p>@Model.Description</p> }</header> }@if (Model.Body is not null) { <div class="z-component-card-body">@Model.Body</div> }@if (Model.Footer is not null) { <footer>@Model.Footer</footer> }</article>
