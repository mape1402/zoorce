@model Zoorce.Web.UI.Foundation.Components.ZoorceButtonOptions
@{
    var classes = $"z-button z-button-{Model.Tone}" + (Model.Compact ? " z-button-sm" : string.Empty);
}
@if (Model.Href is not null)
{
    <a id="@Model.Id" class="@classes" href="@(Model.Disabled ? null : Model.Href)" aria-label="@Model.AriaLabel" aria-disabled="@Model.Disabled.ToString().ToLowerInvariant()" tabindex="@(Model.Disabled ? "-1" : null)">
        @if (Model.Icon is not null) { <span aria-hidden="true">@Model.Icon</span> }<span>@Model.Text</span>
    </a>
}
else
{
    <button id="@Model.Id" class="@classes" type="button" disabled="@Model.Disabled" aria-label="@Model.AriaLabel">
        @if (Model.Icon is not null) { <span aria-hidden="true">@Model.Icon</span> }<span>@Model.Text</span>
    </button>
}
