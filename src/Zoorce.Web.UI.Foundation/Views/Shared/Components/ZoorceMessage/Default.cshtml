@model Zoorce.Web.UI.Foundation.Components.ZoorceMessageOptions
<aside id="@Model.Id" class="z-message z-message-@Model.Tone" role="status" data-z-message><span class="z-message-icon" aria-hidden="true">@(Model.Tone == "danger" ? "!" : Model.Tone == "warning" ? "!" : "i")</span><div><strong>@Model.Title</strong>@if (Model.Description is not null) { <p>@Model.Description</p> }</div>@if (Model.ActionText is not null) { <button type="button" class="z-message-action" data-z-message-action>@Model.ActionText</button> }@if (Model.Dismissible) { <button type="button" class="z-message-close" aria-label="Dismiss message" data-z-message-dismiss>×</button> }</aside>
