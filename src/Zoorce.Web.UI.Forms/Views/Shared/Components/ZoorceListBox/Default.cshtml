@using Zoorce.Web.UI.Forms
@model ZoorceListBoxOptions
@{ var name = Model.Name ?? Model.Id; var messageId = $"{Model.Id}-message"; var values = (Model.Value ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries); var hasMessage = Model.Description is not null || Model.ValidationMessage is not null; }
<div class="z-form-field z-listbox-field @(Model.State == ZoorceFormControlState.Default ? string.Empty : $"is-{Model.State.ToString().ToLowerInvariant()}")" data-z-form-control data-z-form-id="@Model.Id" data-z-form-kind="ListBox" data-z-listbox data-z-multiple="@Model.Multiple.ToString().ToLowerInvariant()">
    @if (Model.Label is not null) { <label class="z-form-label">@Model.Label</label> }
    <input id="@($"{Model.Id}-value")" type="hidden" name="@name" value="@Model.Value" data-z-choice-value />
    <div class="z-listbox" role="listbox" aria-label="@Model.Label" aria-describedby="@(hasMessage ? messageId : null)" aria-invalid="@(Model.State == ZoorceFormControlState.Error ? "true" : null)" aria-multiselectable="@Model.Multiple.ToString().ToLowerInvariant()" aria-readonly="@Model.ReadOnly.ToString().ToLowerInvariant()" style="--z-listbox-height:@(Model.MaxHeight)px" tabindex="@(Model.Disabled ? "-1" : "0")" data-z-listbox-options>@if (Model.Choices.Count == 0) { <p class="z-choice-empty">@Model.EmptyText</p> }@foreach (var choice in Model.Choices) { var selected = values.Contains(choice.Value, StringComparer.OrdinalIgnoreCase); <button type="button" class="z-choice-option @(selected ? "is-selected" : string.Empty)" role="option" aria-selected="@selected.ToString().ToLowerInvariant()" data-z-choice-option data-z-choice-value="@choice.Value" disabled="@(Model.Disabled || Model.ReadOnly || choice.Disabled)">@if (Model.ChoiceTemplate is not null) { @Model.ChoiceTemplate(choice) } else { <span class="z-choice-option-copy">@if (choice.Icon is not null) { <i aria-hidden="true">@choice.Icon</i> }<strong>@choice.Label</strong>@if (choice.Description is not null) { <small>@choice.Description</small> }</span> }</button> }</div>
    @if (hasMessage) { <p id="@messageId" class="z-form-message">@(Model.ValidationMessage ?? Model.Description)</p> }
</div>
