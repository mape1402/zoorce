@using Zoorce.Web.UI.Forms
@model ZoorceDropdownTreeNodeModel
@{ var selected = (Model.Value ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Contains(Model.Item.Value, StringComparer.OrdinalIgnoreCase); var hasChildren = Model.Item.Children.Count > 0; }
<div class="z-tree-choice-node" role="treeitem" aria-level="@Model.Level" aria-selected="@selected.ToString().ToLowerInvariant()" aria-expanded="@(hasChildren ? Model.Expanded.ToString().ToLowerInvariant() : null)">@if (hasChildren) { <button type="button" class="z-tree-choice-expand" aria-label="Toggle @Model.Item.Label" data-z-tree-expand>›</button> } else { <span class="z-tree-choice-spacer"></span> }<button type="button" class="z-tree-choice-option @(selected ? "is-selected" : string.Empty)" data-z-choice-option data-z-choice-value="@Model.Item.Value" data-z-choice-label="@Model.Item.Label" disabled="@(Model.Disabled || Model.Item.Disabled)">@if (Model.Item.Icon is not null) { <i aria-hidden="true">@Model.Item.Icon</i> }<span>@Model.Item.Label</span></button>@if (hasChildren) { <div class="z-tree-choice-children" role="group" hidden="@(!Model.Expanded)">@foreach (var child in Model.Item.Children) { @await Html.PartialAsync("/Views/Shared/Components/ZoorceDropdownTree/_ZoorceDropdownTreeNode.cshtml", new ZoorceDropdownTreeNodeModel(child, Model.Value, Model.Multiple, Model.Expanded, Model.Disabled, Model.Level + 1)) }</div> }</div>
