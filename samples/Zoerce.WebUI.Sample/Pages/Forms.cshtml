@page "/forms"
@{
    ViewData["Title"] = "Component forms";
}

<section>
    <div class="z-page-heading"><div><span class="z-section-kicker">Forms and inputs</span><h1>Low-friction data entry.</h1><p>Fields, validation and control states are engineered to feel calm in either color mode.</p></div></div>
    <div class="z-dashboard-grid">
        <article class="z-panel">
            <form data-z-demo-form onsubmit="return false">
                <div class="z-form-grid">
                    <div class="z-field"><label for="component-name">Component name</label><input class="z-input" id="component-name" data-z-demo-name value="Signal card" /><span class="z-field-hint">A concise, user-facing name.</span></div>
                    <div class="z-field"><label for="component-category">Category</label><select class="z-select" id="component-category"><option>Data visualization</option><option>Feedback</option><option>Navigation</option></select></div>
                    <div class="z-field"><label for="component-owner">Owner / combobox</label><input class="z-input" id="component-owner" list="owners" value="Design systems" /><datalist id="owners"><option value="Design systems"></option><option value="Platform UX"></option><option value="Developer experience"></option></datalist></div>
                    <div class="z-field"><label for="component-date">Release date</label><input class="z-input" id="component-date" type="date" value="2026-10-18" /></div>
                    <div class="z-field z-field-span-2"><label for="component-summary">Summary</label><textarea class="z-textarea" id="component-summary">A premium surface for communicating a primary metric and supporting trend.</textarea></div>
                    <div class="z-field"><label for="invalid-example">Validation state</label><input class="z-input is-invalid" id="invalid-example" value="" placeholder="Name required" /><span class="z-field-error">Enter a descriptive name.</span></div>
                </div>
                <div class="z-filter-row" style="margin-top:17px"><label class="z-check"><input type="checkbox" checked /> Include in the public catalog</label><label class="z-radio"><input type="radio" name="release" checked /> Stable</label><label class="z-radio"><input type="radio" name="release" /> Preview</label><label class="z-switch"><input type="checkbox" checked /><span class="z-switch-track"></span> Enable telemetry</label></div>
                <div class="z-page-actions" style="margin-top:20px"><button class="z-button z-button-primary" type="button" data-z-demo-form-save>Save draft</button><button class="z-button z-button-ghost" type="reset">Reset</button></div>
                <p class="z-card-caption" data-z-demo-form-status aria-live="polite" style="margin-top:12px"></p>
            </form>
        </article>
        <div class="z-insight-stack">
            <article class="z-card"><h2 class="z-card-title">Button variants</h2><div class="z-filter-row" style="margin-top:15px"><button class="z-button z-button-primary" type="button">Primary</button><button class="z-button z-button-secondary" type="button">Secondary</button><button class="z-button z-button-ghost" type="button">Ghost</button><button class="z-button z-button-danger" type="button">Danger</button></div></article>
            <article class="z-empty-state"><div><div class="z-empty-orb">◇</div><h2>No experiments yet</h2><p>Create a variant to compare interactive surfaces before release.</p><button class="z-button z-button-secondary z-button-sm" type="button" data-z-demo-experiment>Create experiment</button></div></article>
        </div>
    </div>
</section>

@section Scripts {
    <script src="/js/sample-demos.js" asp-append-version="true"></script>
}
