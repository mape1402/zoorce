@page "/components"
@{
    ViewData["Title"] = "Component catalog";
}

<section>
    <div class="z-page-heading"><div><span class="z-section-kicker">Component catalog</span><h1>Data dense, still breathable.</h1><p>Search, filters, status and row actions stay clear without turning the page into a spreadsheet.</p></div><button class="z-button z-button-primary" type="button" data-z-toast="A blank component record is ready." data-z-toast-title="New component">+ Add component</button></div>
    <article class="z-panel"><div class="z-toolbar"><label class="z-search-field"><span aria-hidden="true">⌕</span><input type="search" placeholder="Search components..." data-z-filter-input="[data-z-filter-row]" aria-label="Search components" /></label><div class="z-filter-row" data-z-filter-controls><button class="z-filter-chip is-active" type="button" data-z-filter-chip="all" aria-pressed="true">All <span>24</span></button><button class="z-filter-chip" type="button" data-z-filter-chip="stable" aria-pressed="false">Stable</button><button class="z-filter-chip" type="button" data-z-filter-chip="preview" aria-pressed="false">Preview</button></div></div><div class="z-data-shell"><table class="z-data-grid"><thead><tr><th><button type="button">Component ↕</button></th><th>Category</th><th>Theme</th><th>Status</th><th style="text-align:right">Actions</th></tr></thead><tbody><tr data-z-filter-row data-z-filter-status="stable"><td><span class="z-cell-main"><span class="z-cell-mark">CS</span>App shell</span></td><td>Layout</td><td>Dark / Light</td><td><span class="z-status z-status-success">Stable</span></td><td><span class="z-row-actions"><button title="Inspect App shell">⌕</button><button title="Edit App shell">⋯</button></span></td></tr><tr data-z-filter-row data-z-filter-status="stable"><td><span class="z-cell-main"><span class="z-cell-mark">DG</span>Data grid</span></td><td>Data</td><td>Dark / Light</td><td><span class="z-status z-status-success">Stable</span></td><td><span class="z-row-actions"><button title="Inspect Data grid">⌕</button><button title="Edit Data grid">⋯</button></span></td></tr><tr data-z-filter-row data-z-filter-status="preview"><td><span class="z-cell-main"><span class="z-cell-mark">CP</span>Command palette</span></td><td>Navigation</td><td>Dark / Light</td><td><span class="z-status z-status-warning">Preview</span></td><td><span class="z-row-actions"><button title="Inspect Command palette">⌕</button><button title="Edit Command palette">⋯</button></span></td></tr><tr data-z-filter-row data-z-filter-status="updated"><td><span class="z-cell-main"><span class="z-cell-mark">TS</span>Toast service</span></td><td>Feedback</td><td>Dark / Light</td><td><span class="z-status z-status-info">Updated</span></td><td><span class="z-row-actions"><button title="Inspect Toast service">⌕</button><button title="Edit Toast service">⋯</button></span></td></tr></tbody></table><div class="z-pagination"><span>Showing 1–4 of 24 components</span><div class="z-pagination-actions"><button disabled>←</button><button class="is-current">1</button><button>2</button><button>3</button><button>→</button></div></div></div></article>
</section>
