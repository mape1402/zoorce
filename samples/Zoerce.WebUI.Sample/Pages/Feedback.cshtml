@page "/feedback"
@{
    ViewData["Title"] = "Feedback and overlays";
}

<section>
    <div class="z-page-heading"><div><span class="z-section-kicker">Feedback and overlays</span><h1>Responsive feedback, without visual noise.</h1><p>Use the smallest surface that clearly acknowledges an action or asks for a focused decision.</p></div></div>
    <div class="z-card"><div class="z-filter-row"><button class="z-button z-button-primary" type="button" data-z-toast="Your changes were synchronized across the current workspace." data-z-toast-title="Changes saved">Success toast</button><button class="z-button z-button-secondary" type="button" data-z-toast="A new visual audit is waiting for review." data-z-toast-title="Heads up" data-z-toast-kind="warning">Warning toast</button><button class="z-button z-button-ghost" type="button" data-z-toast="The API preview cannot be reached right now." data-z-toast-title="Connection issue" data-z-toast-kind="danger">Error toast</button><button class="z-button z-button-ghost" type="button" data-z-confirm="Archive this preview? The item remains recoverable for thirty days." data-z-confirm-label="Archive" data-z-confirm-success-title="Preview archived" data-z-confirm-success="The sample archive action completed.">Confirm dialog</button><button class="z-button z-button-ghost" type="button" data-z-modal-open="#feedback-modal">Open modal</button><button class="z-button z-button-ghost" type="button" data-z-drawer-open="#feedback-drawer">Open drawer</button></div></div>
</section>

<div class="z-dialog-layer" data-z-modal-layer id="feedback-modal" hidden><section class="z-dialog" role="dialog" aria-modal="true" aria-labelledby="feedback-modal-title" data-z-modal-focus tabindex="-1"><div class="z-dialog-icon" aria-hidden="true">✦</div><div class="z-dialog-copy"><h2 id="feedback-modal-title">Modal component</h2><p>Use this surface for focused decisions or small, self-contained workflows.</p></div><div class="z-dialog-actions"><button class="z-button z-button-ghost" type="button" data-z-modal-close>Close</button><button class="z-button z-button-primary" type="button" data-z-modal-close data-z-toast="The modal action completed." data-z-toast-title="Modal confirmed">Confirm</button></div></section></div>
<div class="z-drawer-layer" data-z-drawer-layer id="feedback-drawer" hidden><aside class="z-drawer" role="dialog" aria-modal="true" aria-labelledby="feedback-drawer-title" data-z-modal-focus tabindex="-1"><div class="z-drawer-header"><div><span class="z-section-kicker">Inspector</span><h2 id="feedback-drawer-title">Drawer component</h2></div><button class="z-icon-button" type="button" data-z-drawer-close aria-label="Close drawer">×</button></div><div class="z-drawer-body"><p class="z-card-caption">Drawers preserve the page context while exposing filters, details or rapid editing.</p><div class="z-drawer-item"><span>Theme</span><strong>Semantic tokens</strong></div><div class="z-drawer-item"><span>Motion</span><strong>Reduced motion aware</strong></div><div class="z-drawer-item"><span>Focus</span><strong>Keyboard ready</strong></div><button class="z-button z-button-primary" style="margin-top:20px" type="button" data-z-drawer-close>Done</button></div></aside></div>
