@page "/navigation"
@using Microsoft.AspNetCore.Html
@using Zoorce.Web.UI.Foundation.Components
@using Zoorce.Web.UI.Navigation.Components
@{
    ViewData["Title"] = "Navigation scale lab";
    var destinations = new[]
    {
        ("release-queue", "Release queue", "Delivery work that is ready for the next decision."),
        ("milestones", "Milestones", "A dated view of the delivery checkpoints that matter."),
        ("roadmap", "Roadmap", "A directional plan for the active product surface."),
        ("reviews", "Reviews", "Cross-functional work waiting for a response."),
        ("risks", "Risks", "Constraints that could affect the current outcome."),
        ("patterns", "Patterns", "Reusable interaction patterns with consistent behavior."),
        ("tokens", "Tokens", "Semantic values that keep every theme coherent."),
        ("accessibility", "Accessibility", "Keyboard, contrast and semantic checks for the system."),
        ("service-health", "Service health", "A concise operational readout for critical services."),
        ("incidents", "Incidents", "Current and resolved incidents with an auditable timeline."),
        ("alerts", "Alerts", "Signals that need an owner before they become interruptions."),
        ("usage", "Usage", "Adoption patterns across active workspaces."),
        ("capacity", "Capacity", "Headroom and resource trends across the platform."),
        ("policies", "Policies", "Guardrails that keep operational choices consistent."),
        ("audit-log", "Audit log", "A chronological record of meaningful system activity."),
        ("retention", "Retention", "Lifecycle settings for workspace information."),
        ("approvals", "Approvals", "Pending decisions that require an accountable reviewer."),
        ("compliance", "Compliance", "Controls mapped to the organization’s commitments."),
        ("members", "Members", "People who can contribute to this workspace."),
        ("roles", "Roles", "Permission sets with explicit responsibilities."),
        ("sessions", "Sessions", "Recent authenticated activity for this product."),
        ("api-access", "API access", "Machine-facing credentials and their scopes."),
        ("service-accounts", "Service accounts", "Non-human identities used by integrations."),
        ("colors", "Colors", "Semantic color decisions for each visual state."),
        ("typography", "Typography", "Text roles that preserve hierarchy at every density."),
        ("spacing", "Spacing", "A measured rhythm for surfaces, groups and controls."),
        ("icons", "Icons", "Compact, recognizable markers for recurring actions."),
        ("motion", "Motion", "Purposeful transitions that respect reduced-motion settings.")
    };
}

<section class="z-page-heading">
    <div>
        <span class="z-section-kicker">Navigation scale lab</span>
        <h1>Deep structure, calm orientation.</h1>
        <p>This sample gives every nested destination a real anchor so the sidebar can be tested with route, hash and three-level navigation states.</p>
    </div>
    <div class="z-page-actions"><a class="z-button z-button-secondary" href="#service-health">Jump to operations</a></div>
</section>

<article class="z-panel">
    <div class="z-card-header">
        <div><h2 class="z-card-title">Compact by default</h2><p class="z-card-caption">Expand Operations, Governance and Access to test a long nested menu. The sidebar scrolls independently from this page.</p></div>
        <div style="display:grid;justify-items:end;gap:8px"><span class="z-badge z-badge-primary">3 levels</span><div class="z-button-group" data-z-selection-group aria-label="Navigation density preview"><button type="button" data-z-density-preview="comfortable" aria-pressed="false">Comfortable</button><button class="is-active" type="button" data-z-density-preview="compact" aria-pressed="true">Compact</button><button type="button" data-z-density-preview="dense" aria-pressed="false">Dense</button></div></div>
    </div>
</article>

<section class="z-section" aria-labelledby="navigation-controls-title">
    <div class="z-form-catalog-heading"><div><span class="z-section-kicker">Reusable navigation controls</span><h2 id="navigation-controls-title">Local state, without a page coordinator.</h2></div><p>Each pattern handles its own focus, arrow keys and emitted selection event. The host only listens when it needs to react.</p></div>
    <div class="z-form-demo-grid">
        @await Component.InvokeAsync("ZoorceAccordion", new ZoorceAccordionOptions { Id = "navigation-accordion", Items = [new ZoorceAccordionItem { Id = "overview", Title = "Overview", Description = "Summary and ownership", Content = new HtmlString("<p>Keep introductory context close to the task it describes.</p>"), Expanded = true }, new ZoorceAccordionItem { Id = "signals", Title = "Signals", Description = "Readiness and risk", Content = new HtmlString("<p>Local expansion preserves the reader’s place in the page.</p>") }] })
        @await Component.InvokeAsync("ZoorceTabs", new ZoorceTabsOptions { Id = "navigation-tabs", Items = [new ZoorceTabItem { Id = "brief", Text = "Brief", Selected = true, Content = new HtmlString("<p class=\"z-card-caption\">A selected tab exposes only its own panel.</p>") }, new ZoorceTabItem { Id = "activity", Text = "Activity", Badge = "3", Content = new HtmlString("<p class=\"z-card-caption\">Arrow keys move between available tabs.</p>") }, new ZoorceTabItem { Id = "settings", Text = "Settings", Content = new HtmlString("<p class=\"z-card-caption\">The host supplies panel markup, not interaction code.</p>") }] })
        @await Component.InvokeAsync("ZoorceTreeView", new ZoorceTreeViewOptions { Id = "navigation-tree", Label = "Component areas", Items = [new ZoorceTreeNode { Value = "foundation", Text = "Foundation", Icon = "✦", Expanded = true, Children = [new ZoorceTreeNode { Value = "feedback", Text = "Feedback" }, new ZoorceTreeNode { Value = "surfaces", Text = "Surfaces" }] }, new ZoorceTreeNode { Value = "forms", Text = "Forms", Icon = "▦", Children = [new ZoorceTreeNode { Value = "selection", Text = "Selection" }, new ZoorceTreeNode { Value = "assets", Text = "Assets" }] }] })
    </div>
    <div class="z-filter-row" style="margin-top:14px">
        @await Component.InvokeAsync("ZoorceMenuBar", new ZoorceMenuBarOptions { Id = "navigation-menu-bar", Items = [new ZoorceMenuItem { Value = "file", Text = "File", Children = [new ZoorceMenuItem { Value = "new", Text = "New release", Shortcut = "⌘ N" }, new ZoorceMenuItem { Value = "duplicate", Text = "Duplicate" }] }, new ZoorceMenuItem { Value = "view", Text = "View", Children = [new ZoorceMenuItem { Value = "details", Text = "Show details" }, new ZoorceMenuItem { Value = "focus", Text = "Focus mode" }] }] })
        @await Component.InvokeAsync("ZoorceToolbar", new ZoorceToolbarOptions { Id = "navigation-toolbar", Label = "Release actions", Items = [new ZoorceMenuItem { Value = "save", Text = "Save", Icon = "✓" }, new ZoorceMenuItem { Value = "share", Text = "Share", Icon = "↗" }, new ZoorceMenuItem { Value = "archive", Text = "Archive", Icon = "⌫" }] })
        <button class="z-button z-button-ghost z-navigation-context-target" type="button">Right-click for actions</button>
        @await Component.InvokeAsync("ZoorceContextMenu", new ZoorceContextMenuOptions { Id = "navigation-context", TargetSelector = ".z-navigation-context-target", Items = [new ZoorceMenuItem { Value = "inspect", Text = "Inspect", Icon = "⌕" }, new ZoorceMenuItem { Value = "copy", Text = "Copy link", Icon = "⧉" }] })
    </div>
</section>

<section class="z-section" aria-labelledby="navigation-extended-title">
    <div class="z-form-catalog-heading"><div><span class="z-section-kicker">Wayfinding and collections</span><h2 id="navigation-extended-title">Keep a large workspace oriented.</h2></div><p>Breadcrumbs collapse their middle locations without dropping hierarchy; pagination emits one small state-change event for the host.</p></div>
    <div class="z-card" style="display:grid;gap:20px">
        @await Component.InvokeAsync("ZoorceBreadcrumb", new ZoorceBreadcrumbOptions { Id = "navigation-breadcrumb", MaxVisible = 3, Items = [new ZoorceBreadcrumbItem { Text = "Workspace", Href = "#workspace", Icon = "⌂" }, new ZoorceBreadcrumbItem { Text = "Delivery", Href = "#delivery" }, new ZoorceBreadcrumbItem { Text = "Releases", Href = "#release-queue" }, new ZoorceBreadcrumbItem { Text = "Autumn release", Current = true }] })
        @await Component.InvokeAsync("ZoorcePagination", new ZoorcePaginationOptions { Id = "navigation-pagination", CurrentPage = 4, TotalPages = 24, PageSize = 25, ShowJumpToPage = true })
    </div>
</section>

@foreach (var destination in destinations)
{
    <section class="z-section" id="@destination.Item1">
        <article class="z-card">
            <span class="z-section-kicker">Linked destination</span>
            <h2 class="z-card-title" style="margin-top:6px">@destination.Item2</h2>
            <p class="z-card-caption">@destination.Item3</p>
        </article>
    </section>
}
