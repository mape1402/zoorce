@page "/diagrams"
@using Zoorce.Web.UI.Diagrams
@using Zoorce.Sample.Infrastructure
@inject SampleDiagramCatalog DiagramCatalog
@{
    ViewData["Title"] = "Diagram studio";
}

<section class="z-diagram-gallery-page">
    <div class="z-diagram-gallery-intro">
        <div>
            <span class="z-section-kicker">Native diagram workspace</span>
            <h1>Model systems visually, without a diagramming dependency.</h1>
            <p>Each canvas is a self-contained component: its own document, selection state, keyboard controls, REST save path and host events. Drag a node, style it from Appearance, connect ports, then use Undo, zoom, Save and Export to create JSON, SVG, JPG, HTML or PDF output. Enable node details to inspect the complete description and optional identifier without expanding the canvas.</p>
        </div>
    </div>

    <article class="z-diagram-demo" data-z-diagram-demo="flow">
        <header class="z-diagram-demo-header"><div><span class="z-section-kicker">Flowchart · editable process</span><h2>Release routing</h2><p>Typed flow nodes, separate yes/no branches and an Appearance panel persisted in the JSON document.</p></div><p class="z-diagram-demo-detail" data-z-diagram-detail>Click a node, then open Appearance.</p></header>
        @await Component.InvokeAsync("ZoorceDiagram", new ZoorceDiagramOptions { Id = "diagram-flow", Title = "Release routing", Summary = "An editable flowchart for a release request", Profile = ZoorceDiagramProfile.Flowchart, Mode = ZoorceDiagramMode.Editor, Layout = ZoorceDiagramLayout.Flow, NodeDetailsEnabled = true, Document = DiagramCatalog.Get("flow"), Binding = new() { Source = "/api/diagrams/flow" }, SaveUrl = "/api/diagrams/flow", Capabilities = new() { CanImport = true } })
    </article>

    <article class="z-diagram-demo" data-z-diagram-demo="mind">
        <header class="z-diagram-demo-header"><div><span class="z-section-kicker">Mind map · expanding context</span><h2>Product signal map</h2><p>Double-click a branch to collapse or reveal its descendants; all nodes remain independently selectable.</p></div><p class="z-diagram-demo-detail" data-z-diagram-detail>Double-click a branch to toggle it.</p></header>
        @await Component.InvokeAsync("ZoorceDiagram", new ZoorceDiagramOptions { Id = "diagram-mind", Title = "Product signal map", Summary = "An editable mind map for product direction", Profile = ZoorceDiagramProfile.MindMap, Mode = ZoorceDiagramMode.Editor, Layout = ZoorceDiagramLayout.Radial, Document = DiagramCatalog.Get("mind"), Binding = new() { Source = "/api/diagrams/mind" }, SaveUrl = "/api/diagrams/mind" })
    </article>

    <article class="z-diagram-demo" data-z-diagram-demo="org">
        <header class="z-diagram-demo-header"><div><span class="z-section-kicker">Org chart · reporting structure</span><h2>Product organization</h2><p>Tree validation prevents multiple parents and makes long reporting paths easy to scan.</p></div><p class="z-diagram-demo-detail" data-z-diagram-detail>Use Fit to center the hierarchy.</p></header>
        @await Component.InvokeAsync("ZoorceDiagram", new ZoorceDiagramOptions { Id = "diagram-org", Title = "Product organization", Summary = "An editable product organization hierarchy", Profile = ZoorceDiagramProfile.OrgChart, Mode = ZoorceDiagramMode.Editor, Layout = ZoorceDiagramLayout.TreeVertical, Document = DiagramCatalog.Get("org"), Binding = new() { Source = "/api/diagrams/org" }, SaveUrl = "/api/diagrams/org" })
    </article>

    <article class="z-diagram-demo" data-z-diagram-demo="architecture">
        <header class="z-diagram-demo-header"><div><span class="z-section-kicker">Architecture · bounded systems</span><h2>Order platform</h2><p>System boundaries, services, queues and stores on the same native connection layer.</p></div><p class="z-diagram-demo-detail" data-z-diagram-detail>Click the API node to emit a host event.</p></header>
        @await Component.InvokeAsync("ZoorceDiagram", new ZoorceDiagramOptions { Id = "diagram-architecture", Title = "Order platform", Summary = "An editable architecture view for an order platform", Profile = ZoorceDiagramProfile.Architecture, Mode = ZoorceDiagramMode.Editor, Layout = ZoorceDiagramLayout.Flow, Document = DiagramCatalog.Get("architecture"), Binding = new() { Source = "/api/diagrams/architecture" }, SaveUrl = "/api/diagrams/architecture" })
    </article>

    <article class="z-diagram-demo" data-z-diagram-demo="audit">
        <header class="z-diagram-demo-header"><div><span class="z-section-kicker">Capabilities · audit view</span><h2>Read-only release audit</h2><p>A safe viewer still supports navigation, node details, actions and export, while every document mutation remains unavailable.</p></div><p class="z-diagram-demo-detail" data-z-diagram-detail>Explore the document or export a snapshot.</p></header>
        @await Component.InvokeAsync("ZoorceDiagram", new ZoorceDiagramOptions { Id = "diagram-audit", Title = "Release audit", Summary = "A read-only flowchart audit", Profile = ZoorceDiagramProfile.Flowchart, Mode = ZoorceDiagramMode.Viewer, Layout = ZoorceDiagramLayout.Flow, NodeDetailsEnabled = true, Document = DiagramCatalog.Get("flow"), Capabilities = new() { CanExport = true, CanInvokeNodeActions = true } })
    </article>

    <article class="z-diagram-demo" data-z-diagram-demo="layout">
        <header class="z-diagram-demo-header"><div><span class="z-section-kicker">Capabilities · layout steward</span><h2>Layout-only refinement</h2><p>Drag nodes and create or inspect connections without exposing content, appearance, deletion, export or the add-node palette.</p></div><p class="z-diagram-demo-detail" data-z-diagram-detail>Drag a node or join two visible anchors.</p></header>
        @await Component.InvokeAsync("ZoorceDiagram", new ZoorceDiagramOptions { Id = "diagram-layout", Title = "Release routing layout", Summary = "A layout-only flowchart editor", Profile = ZoorceDiagramProfile.Flowchart, Mode = ZoorceDiagramMode.Viewer, Layout = ZoorceDiagramLayout.Flow, ShowPalette = false, ShowInspector = false, Document = DiagramCatalog.Get("flow"), Capabilities = new() { CanMoveNodes = true, CanEditConnections = true, CanExport = false } })
    </article>

    <article class="z-diagram-demo" data-z-diagram-demo="curation">
        <header class="z-diagram-demo-header"><div><span class="z-section-kicker">Capabilities · curated intake</span><h2>Content, appearance and import</h2><p>Use this restricted surface to edit labels, metadata and visual treatment, or import a compatible JSON document. Node creation, movement and export are intentionally absent.</p></div><p class="z-diagram-demo-detail" data-z-diagram-detail>Choose a node, change its content or appearance, or import JSON.</p></header>
        @await Component.InvokeAsync("ZoorceDiagram", new ZoorceDiagramOptions { Id = "diagram-curation", Title = "Release curation", Summary = "A content and appearance only flowchart editor", Profile = ZoorceDiagramProfile.Flowchart, Mode = ZoorceDiagramMode.Viewer, Layout = ZoorceDiagramLayout.Flow, ShowPalette = false, Document = DiagramCatalog.Get("flow"), MaximumImportBytes = 262_144, Capabilities = new() { CanEditContent = true, CanEditAppearance = true, CanEditMetadata = true, CanImport = true, CanExport = false } })
    </article>

    <article class="z-diagram-demo" data-z-diagram-demo="reference">
        <header class="z-diagram-demo-header"><div><span class="z-section-kicker">Read-only recipe · sealed reference</span><h2>Production architecture reference</h2><p>A true viewer: no palette, inspector, save, import, export or document mutation. It only permits navigation, zoom and the configured node action.</p></div><p class="z-diagram-demo-detail" data-z-diagram-detail>Select Experience API to dispatch its host event.</p></header>
        @await Component.InvokeAsync("ZoorceDiagram", new ZoorceDiagramOptions { Id = "diagram-reference", Title = "Production architecture", Summary = "A sealed read-only architecture reference", Profile = ZoorceDiagramProfile.Architecture, Mode = ZoorceDiagramMode.ReadOnly, Layout = ZoorceDiagramLayout.Flow, ShowPalette = false, ShowInspector = false, NodeDetailsEnabled = true, Document = DiagramCatalog.Get("architecture"), Capabilities = new() { CanAddNodes = false, CanMoveNodes = false, CanEditConnections = false, CanEditContent = false, CanEditAppearance = false, CanRemoveElements = false, CanEditMetadata = false, CanExport = false, CanImport = false, CanInvokeNodeActions = true } })
    </article>

    <article class="z-diagram-demo" data-z-diagram-demo="copy-review">
        <header class="z-diagram-demo-header"><div><span class="z-section-kicker">Read-only recipe · copy review</span><h2>Wording-only reviewer</h2><p>The canvas structure, positions, connectors, diagram metadata and visual treatment are frozen. Select a node to edit just its title, identifier and description.</p></div><p class="z-diagram-demo-detail" data-z-diagram-detail>Choose a node, edit its text in Content, then use undo or save.</p></header>
        @await Component.InvokeAsync("ZoorceDiagram", new ZoorceDiagramOptions { Id = "diagram-copy-review", Title = "Release copy review", Summary = "A content-only read-only exception", Profile = ZoorceDiagramProfile.Flowchart, Mode = ZoorceDiagramMode.ReadOnly, Layout = ZoorceDiagramLayout.Flow, ShowPalette = false, Document = DiagramCatalog.Get("flow"), Capabilities = new() { CanAddNodes = false, CanMoveNodes = false, CanEditConnections = false, CanEditContent = true, CanEditAppearance = false, CanRemoveElements = false, CanEditMetadata = false, CanExport = false, CanImport = false, CanInvokeNodeActions = false } })
    </article>

    <article class="z-diagram-demo" data-z-diagram-demo="theme-review">
        <header class="z-diagram-demo-header"><div><span class="z-section-kicker">Read-only recipe · visual steward</span><h2>Appearance-only review</h2><p>Keep the model and its labels intact while allowing an approved steward to adjust fills, borders, gradients and type treatment one selected element at a time.</p></div><p class="z-diagram-demo-detail" data-z-diagram-detail>Select a node and open Appearance; Content remains unavailable.</p></header>
        @await Component.InvokeAsync("ZoorceDiagram", new ZoorceDiagramOptions { Id = "diagram-theme-review", Title = "Architecture visual review", Summary = "An appearance-only read-only exception", Profile = ZoorceDiagramProfile.Architecture, Mode = ZoorceDiagramMode.ReadOnly, Layout = ZoorceDiagramLayout.Flow, ShowPalette = false, Document = DiagramCatalog.Get("architecture"), Capabilities = new() { CanAddNodes = false, CanMoveNodes = false, CanEditConnections = false, CanEditContent = false, CanEditAppearance = true, CanRemoveElements = false, CanEditMetadata = false, CanExport = false, CanImport = false, CanInvokeNodeActions = false } })
    </article>

    <article class="z-diagram-demo" data-z-diagram-demo="import-gate">
        <header class="z-diagram-demo-header"><div><span class="z-section-kicker">Read-only recipe · import gate</span><h2>JSON replacement gate</h2><p>The existing diagram cannot be edited in place. The only allowed mutation is replacing it with a compatible JSON document; exports and all other editing tools stay unavailable.</p></div><p class="z-diagram-demo-detail" data-z-diagram-detail>Use Import JSON to replace the local document with the provided fixture.</p></header>
        @await Component.InvokeAsync("ZoorceDiagram", new ZoorceDiagramOptions { Id = "diagram-import-gate", Title = "Release intake gate", Summary = "An import-only read-only exception", Profile = ZoorceDiagramProfile.Flowchart, Mode = ZoorceDiagramMode.ReadOnly, Layout = ZoorceDiagramLayout.Flow, ShowPalette = false, ShowInspector = false, Document = DiagramCatalog.Get("flow"), MaximumImportBytes = 262_144, Capabilities = new() { CanAddNodes = false, CanMoveNodes = false, CanEditConnections = false, CanEditContent = false, CanEditAppearance = false, CanRemoveElements = false, CanEditMetadata = false, CanExport = false, CanImport = true, CanInvokeNodeActions = false } })
    </article>
</section>

@section Scripts {
    <script>
        (() => {
            document.querySelectorAll('[data-z-diagram-demo]').forEach(demo => {
                const detail = demo.querySelector('[data-z-diagram-detail]');
                const diagram = demo.querySelector('[data-z-diagram]');
                if (!detail || !diagram) return;
                diagram.addEventListener('zoorce:diagram:nodeclick', event => {
                    const node = event.detail.node;
                    detail.textContent = node.title + ' · ' + (node.description || node.kind);
                });
                diagram.addEventListener('zoorce:diagram:action', event => {
                    const action = event.detail.action;
                    detail.textContent = 'Host event · ' + action.kind + ' → ' + (action.target || 'default handler');
                });
                diagram.addEventListener('architecture-api', event => {
                    detail.textContent = 'Architecture event · Experience API was selected for host-side detail handling.';
                });
                diagram.addEventListener('flow-release', event => {
                    detail.textContent = 'Release event · The host received the release-stage interaction.';
                });
                diagram.addEventListener('zoorce:diagram:validated', event => {
                    detail.textContent = event.detail.valid ? 'Valid structure · local diagram rules passed.' : 'Validation issue · ' + event.detail.errors[0];
                });
                diagram.addEventListener('zoorce:diagram:imported', event => {
                    detail.textContent = 'Imported · ' + event.detail.fileName + ' replaced the local document. Undo is available.';
                });
                diagram.addEventListener('zoorce:diagram:import-failed', () => {
                    detail.textContent = 'Import issue · choose a compatible JSON diagram with valid nodes and connections.';
                });
            });
        })();
    </script>
}
