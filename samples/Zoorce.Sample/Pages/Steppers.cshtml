@page "/steppers"
@using Zoorce.Web.UI.Navigation.Stepper
@{
    ViewData["Title"] = "Workflow steppers";

    ZoorceStepperStep Step(
        string id,
        string title,
        string? supporting = null,
        string? icon = null,
        ZoorceStepperState state = ZoorceStepperState.Pending,
        string? status = null,
        bool navigable = true,
        bool optional = false,
        string? panelId = null,
        ZoorceStepperTone tone = ZoorceStepperTone.Auto)
        => new(id, title, supporting, icon, state, status, navigable, optional, PanelId: panelId, Tone: tone);

    var releaseSteps = new[]
    {
        Step("release-brief", "Release brief", "Scope and acceptance", "✓", ZoorceStepperState.Completed, "Approved"),
        Step("release-validation", "Validation", "Quality and security", "✓", ZoorceStepperState.Active, "In review"),
        Step("release-handoff", "Handoff", "Release owner", "→", ZoorceStepperState.Pending, "Queued"),
        Step("release-production", "Production", "Observe outcomes", "◉", ZoorceStepperState.Pending, "Waiting")
    };
    var onboardingSteps = new[]
    {
        Step("workspace", "Workspace", "Name and regional settings", "⌘", ZoorceStepperState.Completed, "Completed"),
        Step("members", "Invite members", "Your team can join now", "+", ZoorceStepperState.Active, "In progress", panelId: "wizard-members"),
        Step("governance", "Set guardrails", "Optional policies", "◇", ZoorceStepperState.Pending, "Optional", optional: true, panelId: "wizard-governance"),
        Step("launch", "Ready to launch", "Confirm the workspace", "↗", ZoorceStepperState.Pending, "Waiting", panelId: "wizard-launch")
    };
}

<section class="z-stepper-gallery-page">
    <div class="z-stepper-gallery-intro">
        <div>
            <span class="z-section-kicker">Progress and navigation primitives</span>
            <h1>One workflow model, several clear expressions.</h1>
            <p>Each stepper is server-rendered and self-contained. Choose a rail, segmented context switcher, sidebar journey, or a richer workflow surface without introducing a page-level coordinator.</p>
        </div>
        <button type="button" class="z-button z-button-secondary" data-z-stepper-live-demo>Send live release update</button>
    </div>

    <div class="z-stepper-example-grid">
        <article class="z-stepper-example z-stepper-example--wide">
            <header><span>Rail · REST + SignalR</span><h2>Release readiness</h2><p>The endpoint and live event update only this instance; no layout or page content is replaced.</p></header>
            @await Component.InvokeAsync("ZoorceStepper", new ZoorceStepperOptions
            {
                Id = "release-stepper",
                AriaLabel = "Release readiness workflow",
                Steps = releaseSteps,
                CurrentStepId = "release-validation",
                Variant = ZoorceStepperVariant.Rail,
                Orientation = ZoorceStepperOrientation.Auto,
                Interaction = ZoorceStepperInteraction.Navigation,
                AllowCompletedNavigation = true,
                Binding = new() { Source = "/api/steppers/release", InvalidationScope = "release-stepper" }
            })
        </article>

        <article class="z-stepper-example z-stepper-example--wide">
            <header><span>Segmented · compact navigation</span><h2>Build sequence</h2><p>Short, peer-level phases with an explicit active segment.</p></header>
            @await Component.InvokeAsync("ZoorceStepper", new ZoorceStepperOptions
            {
                Id = "build-stepper",
                AriaLabel = "Build sequence",
                Steps = new[]
                {
                    Step("discover", "Discover", state: ZoorceStepperState.Completed),
                    Step("shape", "Shape", state: ZoorceStepperState.Completed),
                    Step("build", "Build", state: ZoorceStepperState.Active),
                    Step("validate", "Validate"),
                    Step("ship", "Ship")
                },
                CurrentStepId = "build",
                Variant = ZoorceStepperVariant.Segmented,
                Orientation = ZoorceStepperOrientation.Horizontal,
                Interaction = ZoorceStepperInteraction.Navigation,
                Density = ZoorceStepperDensity.Compact,
                ShowStatus = false,
                AllowFutureNavigation = false
            })
        </article>

        <article class="z-stepper-example z-stepper-example--wide z-stepper-example--sidebar">
            <header><span>Sidebar · long journeys</span><h2>Account setup</h2><p>The compact vertical form leaves room for long labels and supporting context.</p></header>
            @await Component.InvokeAsync("ZoorceStepper", new ZoorceStepperOptions
            {
                Id = "account-stepper",
                AriaLabel = "Account setup workflow",
                Steps = new[]
                {
                    Step("identity", "Identity", "Organization profile", "✓", ZoorceStepperState.Completed, "Saved"),
                    Step("access", "Access", "Members and permissions", "⌁", ZoorceStepperState.Active, "In progress"),
                    Step("billing", "Billing", "Payment contact", "¤", ZoorceStepperState.Attention, "Needs review"),
                    Step("review", "Review", "Confirm the account", "→", ZoorceStepperState.Pending, "Waiting")
                },
                CurrentStepId = "access",
                Variant = ZoorceStepperVariant.Sidebar,
                Orientation = ZoorceStepperOrientation.Vertical,
                Interaction = ZoorceStepperInteraction.Navigation,
                Density = ZoorceStepperDensity.Compact
            })
        </article>

        <article class="z-stepper-example z-stepper-example--wide z-stepper-example--workflow">
            <header><span>Workflow · operational status</span><h2>Exception review</h2><p>Use state labels and semantic color where the workflow needs attention.</p></header>
            @await Component.InvokeAsync("ZoorceStepper", new ZoorceStepperOptions
            {
                Id = "review-stepper",
                AriaLabel = "Exception review workflow",
                Steps = new[]
                {
                    Step("received", "Request received", "Intake captured", "✓", ZoorceStepperState.Completed, "Received"),
                    Step("assess", "Assess impact", "Risk review in progress", "!", ZoorceStepperState.Attention, "Needs review"),
                    Step("remediate", "Remediate", "Waiting for owner", "→", ZoorceStepperState.Pending, "Queued"),
                    Step("verify", "Verify outcome", "Independent validation", "◌", ZoorceStepperState.Disabled, "Unavailable", navigable: false)
                },
                CurrentStepId = "assess",
                Variant = ZoorceStepperVariant.Workflow,
                Orientation = ZoorceStepperOrientation.Vertical,
                Interaction = ZoorceStepperInteraction.Navigation,
                AllowCompletedNavigation = true
            })
        </article>

        <article class="z-stepper-example z-stepper-example--wide">
            <header><span>Rail · semantic states and motion</span><h2>Compliance handoff</h2><p>Each step can carry its own semantic tone, marker treatment, connector treatment, and active animation without leaking styles into another instance.</p></header>
            @await Component.InvokeAsync("ZoorceStepper", new ZoorceStepperOptions
            {
                Id = "anatomy-stepper",
                AriaLabel = "Compliance handoff stepper anatomy",
                Steps = new[]
                {
                    Step("intake", "Intake", "Evidence received", "✓", ZoorceStepperState.Completed, "Verified", tone: ZoorceStepperTone.Success),
                    Step("review", "Review", "Analyst is evaluating", "⌕", ZoorceStepperState.Active, "In progress", tone: ZoorceStepperTone.Info),
                    Step("attest", "Attest", "Owner confirmation", "!", ZoorceStepperState.Attention, "Needs review", tone: ZoorceStepperTone.Warning),
                    Step("resolve", "Resolve", "Blocking exception", "×", ZoorceStepperState.Error, "Action required", tone: ZoorceStepperTone.Danger),
                    Step("publish", "Publish", "Available after review", "→", ZoorceStepperState.Disabled, "Unavailable", navigable: false, tone: ZoorceStepperTone.Neutral)
                },
                CurrentStepId = "review",
                Variant = ZoorceStepperVariant.Rail,
                Orientation = ZoorceStepperOrientation.Horizontal,
                Interaction = ZoorceStepperInteraction.Navigation,
                AllowCompletedNavigation = true,
                Presentation = new ZoorceStepperPresentation
                {
                    MarkerStyle = ZoorceStepperMarkerStyle.Icon,
                    ActiveIndicator = ZoorceStepperActiveIndicator.Halo,
                    ActiveMotion = ZoorceStepperActiveMotion.HaloPulse,
                    LabelPlacement = ZoorceStepperLabelPlacement.Below,
                    ConnectorStyle = ZoorceStepperConnectorStyle.Progress
                }
            })
        </article>
    </div>

    <section class="z-stepper-variant-lab" aria-labelledby="stepper-variant-lab-title">
        <header class="z-stepper-variant-lab-heading">
            <span>Additional layouts · same workflow API</span>
            <h2 id="stepper-variant-lab-title">Choose the structure that fits the journey.</h2>
            <p>These four visual variants retain the same state model, navigation rules, theme tokens, and isolated event lifecycle as the existing steppers.</p>
        </header>
        <div class="z-stepper-variant-grid">
            <article class="z-stepper-example z-stepper-example--numbered">
                <header><span>Numbered rail · ordered milestones</span><h2>Account handoff</h2><p>Square numerals and a dotted connector work well when sequence is the main signal.</p></header>
                @await Component.InvokeAsync("ZoorceStepper", new ZoorceStepperOptions
                {
                    Id = "numbered-rail-stepper",
                    AriaLabel = "Account handoff milestones",
                    Steps = new[]
                    {
                        Step("account", "Account", state: ZoorceStepperState.Completed),
                        Step("security", "Security", state: ZoorceStepperState.Active),
                        Step("confirm", "Confirm")
                    },
                    CurrentStepId = "security",
                    Variant = ZoorceStepperVariant.NumberedRail,
                    Orientation = ZoorceStepperOrientation.Horizontal,
                    Interaction = ZoorceStepperInteraction.Navigation,
                    Density = ZoorceStepperDensity.Compact,
                    ShowStatus = false,
                    AllowFutureNavigation = false,
                    Presentation = new ZoorceStepperPresentation
                    {
                        MarkerStyle = ZoorceStepperMarkerStyle.Number,
                        ActiveIndicator = ZoorceStepperActiveIndicator.Solid,
                        ConnectorStyle = ZoorceStepperConnectorStyle.Dotted
                    }
                })
            </article>

            <article class="z-stepper-example z-stepper-example--flat-segments">
                <header><span>Flat segments · compact stage switcher</span><h2>Launch phases</h2><p>A contiguous bar keeps short peer-level phases readable without the chevron language.</p></header>
                @await Component.InvokeAsync("ZoorceStepper", new ZoorceStepperOptions
                {
                    Id = "flat-segment-stepper",
                    AriaLabel = "Launch phases",
                    Steps = new[]
                    {
                        Step("plan", "Plan", state: ZoorceStepperState.Completed),
                        Step("configure", "Configure", state: ZoorceStepperState.Active),
                        Step("launch", "Launch")
                    },
                    CurrentStepId = "configure",
                    Variant = ZoorceStepperVariant.FlatSegments,
                    Orientation = ZoorceStepperOrientation.Horizontal,
                    Interaction = ZoorceStepperInteraction.Navigation,
                    Density = ZoorceStepperDensity.Compact,
                    ShowStatus = false,
                    AllowFutureNavigation = false,
                    Presentation = new ZoorceStepperPresentation
                    {
                        MarkerStyle = ZoorceStepperMarkerStyle.None,
                        ActiveIndicator = ZoorceStepperActiveIndicator.Solid,
                        ConnectorStyle = ZoorceStepperConnectorStyle.None
                    }
                })
            </article>

            <article class="z-stepper-example z-stepper-example--wide z-stepper-example--header-wizard">
                <header><span>Wizard header · action-led progression</span><h2>Identity verification</h2><p>The persistent action bar names the active step, while the compact rail maintains orientation and completion context.</p></header>
                @await Component.InvokeAsync("ZoorceStepper", new ZoorceStepperOptions
                {
                    Id = "header-wizard-stepper",
                    AriaLabel = "Identity verification wizard",
                    Steps = new[]
                    {
                        Step("profile", "Profile", state: ZoorceStepperState.Completed),
                        Step("verify", "Verification", state: ZoorceStepperState.Active),
                        Step("complete", "Complete")
                    },
                    CurrentStepId = "verify",
                    Variant = ZoorceStepperVariant.WizardHeader,
                    Orientation = ZoorceStepperOrientation.Horizontal,
                    Interaction = ZoorceStepperInteraction.Wizard,
                    Density = ZoorceStepperDensity.Compact,
                    ShowStatus = false,
                    PreviousLabel = "Previous",
                    NextLabel = "Next",
                    CompleteLabel = "Finish verification",
                    Presentation = new ZoorceStepperPresentation
                    {
                        MarkerStyle = ZoorceStepperMarkerStyle.Dot,
                        ActiveIndicator = ZoorceStepperActiveIndicator.Halo,
                        ActiveMotion = ZoorceStepperActiveMotion.RingPulse,
                        ConnectorStyle = ZoorceStepperConnectorStyle.Progress
                    }
                })
            </article>

            <article class="z-stepper-example z-stepper-example--wide z-stepper-example--minimal-rail">
                <header><span>Minimal rail · low-chrome progression</span><h2>Brief submission</h2><p>The active label floats above its marker; the rest of the rail remains intentionally quiet.</p></header>
                @await Component.InvokeAsync("ZoorceStepper", new ZoorceStepperOptions
                {
                    Id = "minimal-rail-stepper",
                    AriaLabel = "Brief submission progress",
                    Steps = new[]
                    {
                        Step("start", "Start", state: ZoorceStepperState.Completed, tone: ZoorceStepperTone.Primary),
                        Step("details", "Details", state: ZoorceStepperState.Active, tone: ZoorceStepperTone.Primary),
                        Step("confirm-brief", "Confirm")
                    },
                    CurrentStepId = "details",
                    Variant = ZoorceStepperVariant.MinimalRail,
                    Orientation = ZoorceStepperOrientation.Horizontal,
                    Interaction = ZoorceStepperInteraction.Navigation,
                    Density = ZoorceStepperDensity.Compact,
                    ShowStatus = false,
                    AllowFutureNavigation = false,
                    Presentation = new ZoorceStepperPresentation
                    {
                        MarkerStyle = ZoorceStepperMarkerStyle.Number,
                        ActiveIndicator = ZoorceStepperActiveIndicator.Ring,
                        LabelPlacement = ZoorceStepperLabelPlacement.Above,
                        ConnectorStyle = ZoorceStepperConnectorStyle.Solid
                    }
                })
            </article>
        </div>
    </section>

    <article class="z-stepper-example z-stepper-example--wizard">
        <header><span>Wizard · controlled progression</span><h2>First workspace setup</h2><p>The action buttons move one adjacent step at a time. Consumers can intercept <code>zoorce:stepper:request-change</code> to validate server state before permitting a transition.</p></header>
        <div class="z-stepper-wizard-layout">
            @await Component.InvokeAsync("ZoorceStepper", new ZoorceStepperOptions
            {
                Id = "workspace-wizard",
                AriaLabel = "First workspace setup",
                Steps = onboardingSteps,
                CurrentStepId = "members",
                Variant = ZoorceStepperVariant.Rail,
                Orientation = ZoorceStepperOrientation.Vertical,
                Interaction = ZoorceStepperInteraction.Wizard,
                AllowFutureNavigation = false,
                PreviousLabel = "Previous",
                NextLabel = "Continue",
                CompleteLabel = "Create workspace"
            })
            <section class="z-stepper-wizard-panel" aria-live="polite">
                <div data-z-wizard-panel="workspace" hidden><span>Step 1</span><h3>Workspace foundations</h3><p>Your workspace information is complete. Continue to add people who will use it.</p></div>
                <div data-z-wizard-panel="members"><span>Step 2</span><h3>Invite collaborators</h3><p>Add the people who should receive the first workspace invitation. You can invite more later.</p><button type="button" class="z-button z-button-secondary z-button-sm" data-z-toast="Invitation list saved locally for this demo." data-z-toast-title="Members ready">Review invitations</button></div>
                <div data-z-wizard-panel="governance" hidden><span>Step 3 · optional</span><h3>Set lightweight guardrails</h3><p>Choose the data retention and review defaults appropriate for this workspace.</p></div>
                <div data-z-wizard-panel="launch" hidden><span>Step 4</span><h3>Everything is ready</h3><p>Confirm the setup to create the workspace and begin the first project.</p></div>
            </section>
        </div>
    </article>

    <article class="z-stepper-example z-stepper-example--wizard">
        <header><span>Wizard · server-authorized transition rules</span><h2>Release gate</h2><p>This warning step requests approval from a dedicated endpoint. The same component declares adjacent-only forward movement, completed-only backward movement, and reset-on-back behavior.</p></header>
        <div class="z-stepper-wizard-layout">
            @await Component.InvokeAsync("ZoorceStepper", new ZoorceStepperOptions
            {
                Id = "policy-wizard",
                AriaLabel = "Release gate with policy-controlled progression",
                Steps = new[]
                {
                    Step("scope", "Scope", "Acceptance criteria agreed", "✓", ZoorceStepperState.Completed, "Completed", tone: ZoorceStepperTone.Success),
                    Step("risk", "Risk review", "One decision needs approval", "!", ZoorceStepperState.Attention, "Authorization required", panelId: "policy-risk", tone: ZoorceStepperTone.Warning),
                    Step("approval", "Approval", "Release owner confirms", "⌁", ZoorceStepperState.Pending, "Waiting", panelId: "policy-approval", tone: ZoorceStepperTone.Info),
                    Step("release", "Release", "Production handoff", "↗", ZoorceStepperState.Pending, "Waiting", panelId: "policy-release")
                },
                CurrentStepId = "risk",
                Variant = ZoorceStepperVariant.Rail,
                Orientation = ZoorceStepperOrientation.Vertical,
                Interaction = ZoorceStepperInteraction.Wizard,
                PreviousLabel = "Back",
                NextLabel = "Request approval",
                CompleteLabel = "Release now",
                TransitionUrl = "/api/steppers/policy-transition",
                Presentation = new ZoorceStepperPresentation
                {
                    MarkerStyle = ZoorceStepperMarkerStyle.Number,
                    ActiveIndicator = ZoorceStepperActiveIndicator.Ring,
                    ActiveMotion = ZoorceStepperActiveMotion.RingPulse,
                    LabelPlacement = ZoorceStepperLabelPlacement.End,
                    ConnectorStyle = ZoorceStepperConnectorStyle.Progress
                },
                TransitionRules = new ZoorceStepperTransitionRules
                {
                    Forward = ZoorceStepperForwardRule.AdjacentOnly,
                    Backward = ZoorceStepperBackwardRule.CompletedOnly,
                    Warning = ZoorceStepperWarningRule.RequireAuthorization,
                    Error = ZoorceStepperErrorRule.Block,
                    OnBackward = ZoorceStepperBackwardEffect.ResetFollowing
                }
            })
            <section class="z-stepper-wizard-panel" aria-live="polite">
                <span>Rule feedback</span><h3 data-z-policy-title>Risk review is awaiting approval</h3><p data-z-policy-message>The first advance calls the isolated transition endpoint. Try Continue, then Back: later steps return to Pending because this workflow explicitly resets them.</p>
            </section>
        </div>
    </article>
</section>

@section Scripts {
    <script src="/vendor/signalr/signalr.min.js"></script>
    <script src="~/_content/Zoorce.Web.UI.Realtime.SignalR/js/zoorce-realtime-signalr.js" asp-append-version="true"></script>
    <script>
        (() => {
            const wizard = document.querySelector("#workspace-wizard");
            wizard?.addEventListener("zoorce:stepper:change", event => {
                document.querySelectorAll("[data-z-wizard-panel]").forEach(panel => {
                    panel.hidden = panel.dataset.zWizardPanel !== event.detail.stepId;
                });
            });

            const policyWizard = document.querySelector("#policy-wizard");
            const policyTitle = document.querySelector("[data-z-policy-title]");
            const policyMessage = document.querySelector("[data-z-policy-message]");
            policyWizard?.addEventListener("zoorce:stepper:change", event => {
                const copy = {
                    risk: ["Risk review is awaiting approval", "This step requires the server to accept the transition before the component changes state."],
                    approval: ["Approval is active", "The server authorized the warning step. Continue to complete the release gate."],
                    release: ["Release is ready", "The final transition was authorized. This isolated component did not replace or rerender the page."],
                    scope: ["Scope is active", "The explicit reset-on-back rule returned later steps to Pending."]
                }[event.detail.stepId];
                if (copy) {
                    policyTitle.textContent = copy[0];
                    policyMessage.textContent = copy[1];
                }
            });
            policyWizard?.addEventListener("zoorce:stepper:error", () => {
                policyTitle.textContent = "Approval could not be checked";
                policyMessage.textContent = "The component kept its current step intact; try again when the transition endpoint is available.";
            });

            document.querySelector("[data-z-stepper-live-demo]")?.addEventListener("click", async event => {
                const button = event.currentTarget;
                button.disabled = true;
                try {
                    await fetch("/api/demo/stepper", { method: "POST" });
                } finally {
                    button.disabled = false;
                }
            });
        })();
    </script>
}
