@page
@model IndexModel
@using Microsoft.AspNetCore.Html
@using Zoorce.Web.UI.Foundation.Components
@{
    ViewData["Title"] = "Component control center";
}

<section id="dashboard">
    <div class="z-page-heading">
        <div><span class="z-section-kicker">Live design system</span><h1>Build interfaces with signal.</h1><p>Every element in this workspace is provided by Zoorce: a dark-first Razor Pages UI foundation with configurable colors, accessible interactions, and responsive surfaces.</p></div>
        <div class="z-page-actions"><button class="z-button z-button-ghost" type="button" data-z-command-open>⌕ Explore</button><button class="z-button z-button-primary" type="button" data-z-static-catalogue-insert>✦ Create component</button></div>
    </div>

    <div class="z-metric-grid" aria-label="Dashboard metrics">
        <article class="z-card z-metric-card"><span class="z-metric-label">Reusable primitives</span><strong class="z-metric-value">48</strong><span class="z-metric-trend">↗ 18% this sprint</span></article>
        <article class="z-card z-metric-card"><span class="z-metric-label">Theme coverage</span><strong class="z-metric-value">100%</strong><span class="z-metric-trend">✓ Dark + Light ready</span></article>
        <article class="z-card z-metric-card"><span class="z-metric-label">Interaction latency</span><strong class="z-metric-value">16ms</strong><span class="z-metric-trend">↗ Smooth by default</span></article>
        <article class="z-card z-metric-card"><span class="z-metric-label">Accessibility checks</span><strong class="z-metric-value">AA</strong><span class="z-metric-trend">✓ Keyboard first</span></article>
    </div>

    <div class="z-dashboard-grid z-section">
        <article class="z-card z-chart-card">
            <div class="z-chart-header"><div><p class="z-card-title">Component adoption</p><p class="z-card-caption">Usage across active products</p><div class="z-chart-total">18,492 <span class="z-metric-trend">↗ 24.8%</span></div></div><div class="z-button-group" data-z-selection-group aria-label="Chart range"><button class="is-active" type="button" aria-pressed="true">30d</button><button type="button" aria-pressed="false">90d</button><button type="button" aria-pressed="false">Year</button></div></div>
            <svg class="z-chart" viewBox="0 0 650 180" role="img" aria-label="A rising line chart representing component adoption"><defs><linearGradient id="z-chart-gradient" x1="0" x2="0" y1="0" y2="1"><stop stop-color="var(--z-primary)" stop-opacity=".48" /><stop offset="1" stop-color="var(--z-primary)" stop-opacity="0" /></linearGradient></defs><path class="z-chart-grid" d="M0 25H650M0 75H650M0 125H650M0 175H650" /><path class="z-chart-fill" d="M0 148 C55 140 70 102 118 115 S188 139 222 93 S296 47 338 82 S396 120 433 71 S508 53 545 41 S610 61 650 16 V180 H0 Z" /><path class="z-chart-line" d="M0 148 C55 140 70 102 118 115 S188 139 222 93 S296 47 338 82 S396 120 433 71 S508 53 545 41 S610 61 650 16" /><path class="z-chart-line-secondary" d="M0 158 C64 136 93 163 131 143 S200 108 241 129 S309 117 346 104 S421 122 463 94 S530 111 565 77 S616 94 650 65" /><circle class="z-chart-dot" cx="545" cy="41" r="5" /></svg>
        </article>
        <div class="z-insight-stack">
            <article class="z-card"><div class="z-card-header"><div><h2 class="z-card-title">Design consistency</h2><p class="z-card-caption">System health score</p></div><span class="z-status z-status-success">Excellent</span></div><div class="z-donut-wrap"><div class="z-donut"></div><div class="z-insight-copy"><strong>Visual rhythm is stable.</strong><p>Token usage and spacing conventions are applied to all sample surfaces.</p></div></div></article>
            <article class="z-card"><div class="z-card-header"><div><h2 class="z-card-title">Next release</h2><p class="z-card-caption">Component package</p></div><span class="z-badge z-badge-primary">v0.1.0</span></div><p class="z-card-caption" style="margin-top:16px">Foundation, shell, feedback and data patterns.</p><div class="z-progress" aria-label="Release progress"><span style="width:78%"></span></div><p class="z-card-caption" style="margin-top:8px">78% validated</p></article>
        </div>
    </div>
</section>

<section class="z-section" id="feedback">
    <div class="z-section-heading"><div><span class="z-section-kicker">Feedback and overlays</span><h2>Responsive feedback, without visual noise.</h2><p>Toast notifications, confirmations, modal dialogs, drawers, tooltips, loading and empty states.</p></div></div>
    <div class="z-card"><div class="z-filter-row"><button class="z-button z-button-primary" type="button" data-z-toast="Your changes were synchronized across the current workspace." data-z-toast-title="Changes saved">Success toast</button><button class="z-button z-button-secondary" type="button" data-z-toast="A new visual audit is waiting for review." data-z-toast-title="Heads up" data-z-toast-kind="warning">Warning toast</button><button class="z-button z-button-ghost" type="button" data-z-toast="The API preview cannot be reached right now." data-z-toast-title="Connection issue" data-z-toast-kind="danger">Error toast</button><form method="post" asp-page-handler="ServerToast"><button class="z-button z-button-ghost" type="submit">Server toast</button></form><button class="z-button z-button-ghost" type="button" data-z-confirm="Archive this preview? The item remains recoverable for thirty days." data-z-confirm-label="Archive" data-z-confirm-success-title="Preview archived" data-z-confirm-success="The sample archive action completed.">Confirm dialog</button><button class="z-button z-button-ghost" type="button" data-z-modal-open="#demo-modal">Open modal</button><button class="z-button z-button-ghost" type="button" data-z-drawer-open="#demo-component-drawer">Open drawer</button><button class="z-icon-button" type="button" title="A concise tooltip for a compact icon action" aria-label="Information tooltip">i</button></div></div>
</section>

<section class="z-section" id="data-grid">
    <div class="z-section-heading"><div><span class="z-section-kicker">Data grid</span><h2>Data dense, still breathable.</h2><p>Search, filters, status, row actions, sorting affordances and pagination.</p></div><button class="z-button z-button-primary z-button-sm" type="button" data-z-toast="A blank component record is ready." data-z-toast-title="New component">+ Add component</button></div>
    <article class="z-panel"><div class="z-toolbar"><label class="z-search-field"><span aria-hidden="true">⌕</span><input type="search" placeholder="Search components..." data-z-filter-input="[data-z-filter-row]" aria-label="Search components" /></label><div class="z-filter-row" data-z-filter-controls><button class="z-filter-chip is-active" type="button" data-z-filter-chip="all" aria-pressed="true">All <span>24</span></button><button class="z-filter-chip" type="button" data-z-filter-chip="stable" aria-pressed="false">Stable</button><button class="z-filter-chip" type="button" data-z-filter-chip="preview" aria-pressed="false">Preview</button></div></div><div class="z-data-shell"><table class="z-data-grid"><thead><tr><th><button type="button">Component ↕</button></th><th>Category</th><th>Theme</th><th>Status</th><th style="text-align:right">Actions</th></tr></thead><tbody><tr data-z-filter-row data-z-filter-status="stable"><td><span class="z-cell-main"><span class="z-cell-mark">CS</span>App shell</span></td><td>Layout</td><td>Dark / Light</td><td><span class="z-status z-status-success">Stable</span></td><td><span class="z-row-actions"><button title="Inspect App shell">⌕</button><button title="Edit App shell">⋯</button></span></td></tr><tr data-z-filter-row data-z-filter-status="stable"><td><span class="z-cell-main"><span class="z-cell-mark">DG</span>Data grid</span></td><td>Data</td><td>Dark / Light</td><td><span class="z-status z-status-success">Stable</span></td><td><span class="z-row-actions"><button title="Inspect Data grid">⌕</button><button title="Edit Data grid">⋯</button></span></td></tr><tr data-z-filter-row data-z-filter-status="preview"><td><span class="z-cell-main"><span class="z-cell-mark">CP</span>Command palette</span></td><td>Navigation</td><td>Dark / Light</td><td><span class="z-status z-status-warning">Preview</span></td><td><span class="z-row-actions"><button title="Inspect Command palette">⌕</button><button title="Edit Command palette">⋯</button></span></td></tr><tr data-z-filter-row data-z-filter-status="updated"><td><span class="z-cell-main"><span class="z-cell-mark">TS</span>Toast service</span></td><td>Feedback</td><td>Dark / Light</td><td><span class="z-status z-status-info">Updated</span></td><td><span class="z-row-actions"><button title="Inspect Toast service">⌕</button><button title="Edit Toast service">⋯</button></span></td></tr></tbody></table><div class="z-pagination"><span>Showing 1–4 of 24 components</span><div class="z-pagination-actions"><button disabled>←</button><button class="is-current">1</button><button>2</button><button>3</button><button>→</button></div></div></div></article>
</section>

<section class="z-section" id="forms">
    <div class="z-section-heading"><div><span class="z-section-kicker">Forms and inputs</span><h2>Low-friction data entry.</h2><p>Consistent labels, error states, controls and focus treatment.</p></div></div>
    <div class="z-dashboard-grid"><article class="z-panel"><form onsubmit="return false"><div class="z-form-grid"><div class="z-field"><label for="component-name">Component name</label><input class="z-input" id="component-name" value="Signal card" /><span class="z-field-hint">A concise, user-facing name.</span></div><div class="z-field"><label for="component-category">Category</label><select class="z-select" id="component-category"><option>Data visualization</option><option>Feedback</option><option>Navigation</option></select></div><div class="z-field"><label for="component-owner">Owner / combobox</label><input class="z-input" id="component-owner" list="owners" value="Design systems" /><datalist id="owners"><option value="Design systems"></option><option value="Platform UX"></option><option value="Developer experience"></option></datalist></div><div class="z-field"><label for="component-date">Release date</label><input class="z-input" id="component-date" type="date" value="2026-10-18" /></div><div class="z-field z-field-span-2"><label for="component-summary">Summary</label><textarea class="z-textarea" id="component-summary">A premium surface for communicating a primary metric and supporting trend.</textarea></div><div class="z-field"><span class="z-field-label">Release window</span><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px"><input class="z-input" type="date" value="2026-10-18" aria-label="Start date" /><input class="z-input" type="date" value="2026-10-31" aria-label="End date" /></div></div><div class="z-field"><label for="invalid-example">Validation state</label><input class="z-input is-invalid" id="invalid-example" value="" placeholder="Name required" /><span class="z-field-error">Enter a descriptive name.</span></div></div><div class="z-filter-row" style="margin-top:17px"><label class="z-check"><input type="checkbox" checked /> Include in the public catalog</label><label class="z-radio"><input type="radio" name="release" checked /> Stable</label><label class="z-radio"><input type="radio" name="release" /> Preview</label><label class="z-switch"><input type="checkbox" checked /><span class="z-switch-track"></span> Enable telemetry</label></div><div class="z-page-actions" style="margin-top:20px"><button class="z-button z-button-primary" type="button" data-z-toast="The component draft is ready for review." data-z-toast-title="Draft saved">Save draft</button><button class="z-button z-button-ghost" type="reset">Reset</button></div></form></article>
        <div class="z-insight-stack"><article class="z-card"><h3 class="z-card-title">Button variants</h3><div class="z-filter-row" style="margin-top:15px"><button class="z-button z-button-primary" type="button">Primary</button><button class="z-button z-button-secondary" type="button">Secondary</button><button class="z-button z-button-ghost" type="button">Ghost</button><button class="z-button z-button-danger" type="button">Danger</button><button class="z-button z-button-primary" type="button" disabled>Loading</button></div></article><article class="z-card"><h3 class="z-card-title">Loading skeleton</h3><div style="margin-top:15px"><div class="z-skeleton z-skeleton-line"></div><div class="z-skeleton z-skeleton-line"></div><div class="z-skeleton z-skeleton-line short"></div></div></article><article class="z-empty-state"><div><div class="z-empty-orb">◇</div><h3>No experiments yet</h3><p>Create a variant to compare interactive surfaces before release.</p><button class="z-button z-button-secondary z-button-sm" type="button">Create experiment</button></div></article></div>
    </div>
</section>

<section class="z-section"><div class="z-section-heading"><div><span class="z-section-kicker">Tabs, status and activity</span><h2>Small elements that make an app feel deliberate.</h2></div></div><article class="z-panel"><div data-z-tabs class="z-tabs" role="tablist" aria-label="Sample content tabs"><button class="z-tab" role="tab" aria-selected="true" aria-controls="tab-overview">Overview</button><button class="z-tab" role="tab" aria-selected="false" aria-controls="tab-activity">Activity</button><button class="z-tab" role="tab" aria-selected="false" aria-controls="tab-settings">Settings</button></div><div class="z-tab-panel" id="tab-overview" role="tabpanel"><div class="z-dashboard-grid" style="margin-top:17px"><div><h3 class="z-card-title">Visual states</h3><p class="z-card-caption">Badges and semantic status values remain clear in both themes.</p><div class="z-filter-row" style="margin-top:13px"><span class="z-status z-status-success">Active</span><span class="z-status z-status-info">In review</span><span class="z-status z-status-warning">Waiting</span><span class="z-status z-status-danger">Blocked</span><span class="z-badge">Razor Pages</span><span class="z-badge z-badge-primary">Tailwind</span></div></div><div><h3 class="z-card-title">Progress</h3><p class="z-card-caption">Release completion</p><div class="z-progress" style="margin-top:14px"><span style="width:64%"></span></div><p class="z-card-caption" style="margin-top:8px">64% of acceptance criteria ready</p></div></div></div><div class="z-tab-panel" id="tab-activity" role="tabpanel" hidden><p class="z-card-caption">Activity feed: theme tokens were synchronized, toast interactions passed, and the shell remained responsive.</p></div><div class="z-tab-panel" id="tab-settings" role="tabpanel" hidden><p class="z-card-caption">Settings are supplied by each consuming host through dependency injection.</p></div></article></section>

<section class="z-section" id="documentation"><div class="z-section-heading"><div><span class="z-section-kicker">Documentation layout</span><h2>A focused reading mode for technical systems.</h2><p>Sidebar navigation, table of contents, code blocks, callouts and copy controls.</p></div></div><div class="z-docs-layout"><aside class="z-docs-nav"><strong>On this page</strong><a class="is-active" href="#documentation">Getting started</a><a href="#data-grid">Data grid</a><a href="#forms">Forms</a><a href="#feedback">Feedback</a></aside><article class="z-docs-article"><span class="z-section-kicker">Integration</span><h1>Install the Zoorce shell.</h1><p>The application owns its navigation and branding; Zoorce owns the visual contract and provides semantic theme tokens to every component.</p><div class="z-callout"><strong>Tip</strong><span>Set both <code>Light</code> and <code>Dark</code> palette colors in dependency injection to retain your product identity in every mode.</span></div><h2>Register the library</h2><pre class="z-code-block" id="registration-code"><code>builder.Services.AddRazorPages().AddZoorceWebUI(options =&gt; { options.ApplicationName = &quot;Your product&quot;; options.Dark.Primary = &quot;#20e7a0&quot;; options.Light.Primary = &quot;#087f5b&quot;; });</code><button class="z-code-copy" type="button" data-z-copy="#registration-code">Copy</button></pre><h2>API endpoint</h2><div class="z-data-shell"><table class="z-data-grid"><thead><tr><th>Method</th><th>Route</th><th>Description</th></tr></thead><tbody><tr><td><span class="z-badge z-badge-primary">POST</span></td><td><code>/api/components</code></td><td>Create a reusable catalog component.</td></tr></tbody></table></div></article><aside class="z-docs-toc"><strong>Contents</strong><a href="#documentation">Install</a><a href="#forms">Configure</a><a href="#feedback">Validate</a></aside></div></section>

<div class="z-dialog-layer" data-z-modal-layer id="demo-modal" hidden><section class="z-dialog" role="dialog" aria-modal="true" aria-labelledby="demo-modal-title" data-z-modal-focus tabindex="-1"><div class="z-dialog-icon" aria-hidden="true">✦</div><div class="z-dialog-copy"><h2 id="demo-modal-title">Modal component</h2><p>Use this surface for focused decisions or small, self-contained workflows.</p></div><div class="z-dialog-actions"><button class="z-button z-button-ghost" type="button" data-z-modal-close>Close</button><button class="z-button z-button-primary" type="button" data-z-modal-close data-z-toast="The modal action completed." data-z-toast-title="Modal confirmed">Confirm</button></div></section></div>
@await Component.InvokeAsync("ZoorceDrawer", new ZoorceDrawerOptions { Id = "demo-component-drawer", Title = "Drawer component", Description = "An inspector surface built from the reusable drawer control.", Position = ZoorceDrawerPosition.End, Size = ZoorceDrawerSize.Compact, Body = new HtmlString("<p class=\"z-card-caption\">Drawers preserve page context while exposing filters, details or rapid editing.</p><div class=\"z-drawer-item\"><span>Theme</span><strong>Semantic tokens</strong></div><div class=\"z-drawer-item\"><span>Motion</span><strong>Reduced motion aware</strong></div><div class=\"z-drawer-item\"><span>Focus</span><strong>Keyboard ready</strong></div>"), Footer = new HtmlString("<button class=\"z-button z-button-primary\" type=\"button\" data-z-drawer-close>Done</button>") })

@section Scripts {
    <script src="/js/sample-demos.js" asp-append-version="true"></script>
}
