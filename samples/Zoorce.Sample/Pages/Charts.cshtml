@page "/charts"
@using Zoorce.Web.UI.Charts
@{
    ViewData["Title"] = "Native charts";
    ZoorceChartSeries Series(string name, params ZoorceChartPoint[] points) => new(name, points);

    var adoption = new[]
    {
        Series("Adoption", new("May", 48), new("Jun", 56), new("Jul", 54), new("Aug", 67), new("Sep", 74), new("Oct", 82), new("Nov", 88)),
        Series("Target", new("May", 52), new("Jun", 58), new("Jul", 64), new("Aug", 68), new("Sep", 74), new("Oct", 80), new("Nov", 84))
    };
    var stackedLatency = new[]
    {
        Series("Resolve RTT", new("12:30", 980), new("12:31", 930), new("12:32", 1010), new("12:33", 960), new("12:34", 1040), new("12:35", 2310), new("12:36", 1010), new("12:37", 1140), new("12:38", 1990), new("12:39", 1120), new("12:40", 980), new("12:41", 1620), new("12:42", 860)),
        Series("TCP connect", new("12:30", 360), new("12:31", 290), new("12:32", 310), new("12:33", 300), new("12:34", 330), new("12:35", 420), new("12:36", 290), new("12:37", 520), new("12:38", 410), new("12:39", 320), new("12:40", 350), new("12:41", 290), new("12:42", 270)),
        Series("Handshake", new("12:30", 710), new("12:31", 960), new("12:32", 760), new("12:33", 850), new("12:34", 690), new("12:35", 810), new("12:36", 790), new("12:37", 720), new("12:38", 970), new("12:39", 770), new("12:40", 740), new("12:41", 620), new("12:42", 680))
    };
    var channels = new[]
    {
        Series("Product", new("Direct", 42), new("Partners", 31), new("Community", 18), new("Inbound", 9)),
        Series("Expansion", new("Direct", 21), new("Partners", 34), new("Community", 25), new("Inbound", 20))
    };
    var ranking = new[] { Series("Response time", new("Search", 97), new("Checkout", 88), new("Analytics", 76), new("Imports", 61), new("Exports", 43)) };
    var distribution = new[] { Series("Status", new("Healthy", 72), new("Watch", 18), new("Risk", 10)) };
    var gauge = new[] { Series("SLA met", new ZoorceChartPoint("Current", 96.4m)) };
    var funnel = new[] { Series("Journey", new("Visited", 18400), new("Signed up", 7200), new("Activated", 3980), new("Converted", 1840)) };
    var heatmap = new[] { Series("Activity",
        new("08", 18, Group: "Mon"), new("12", 42, Group: "Mon"), new("16", 71, Group: "Mon"), new("20", 26, Group: "Mon"),
        new("08", 27, Group: "Tue"), new("12", 58, Group: "Tue"), new("16", 94, Group: "Tue"), new("20", 40, Group: "Tue"),
        new("08", 13, Group: "Wed"), new("12", 38, Group: "Wed"), new("16", 63, Group: "Wed"), new("20", 22, Group: "Wed"),
        new("08", 46, Group: "Thu"), new("12", 79, Group: "Thu"), new("16", 86, Group: "Thu"), new("20", 54, Group: "Thu"),
        new("08", 21, Group: "Fri"), new("12", 49, Group: "Fri"), new("16", 77, Group: "Fri"), new("20", 31, Group: "Fri")) };
    var scatter = new[]
    {
        Series("Enterprise", new("Atlas", 82, X: 71), new("KnOwl", 68, X: 58), new("Orbit", 91, X: 86)),
        Series("Growth", new("Nova", 56, X: 35), new("Axis", 74, X: 64), new("Flow", 63, X: 49))
    };
    var bubbles = new[] { Series("Accounts", new("North", 74, X: 55, Size: 17), new("West", 48, X: 37, Size: 11), new("South", 88, X: 79, Size: 24), new("East", 64, X: 68, Size: 14)) };
    var histogram = new[] { Series("Latency", new("0–50", 18), new("50–100", 44), new("100–150", 72), new("150–200", 39), new("200–250", 16), new("250+", 7)) };
    var waterfall = new[] { Series("Revenue", new("Base", 120), new("New", 46), new("Expansion", 28), new("Churn", -31), new("Credits", -12), new("Close", 19)) };
    var range = new[] { Series("Forecast", new("May", 54, Low: 42, High: 62), new("Jun", 61, Low: 49, High: 71), new("Jul", 57, Low: 46, High: 68), new("Aug", 70, Low: 60, High: 79), new("Sep", 74, Low: 65, High: 86)) };
    var combo = new[]
    {
        Series("Requests", new ZoorceChartPoint("May", 38), new ZoorceChartPoint("Jun", 52), new ZoorceChartPoint("Jul", 48), new ZoorceChartPoint("Aug", 67), new ZoorceChartPoint("Sep", 72)) with { RenderAs = ZoorceChartSeriesKind.Bar },
        Series("Success rate", new ZoorceChartPoint("May", 91), new ZoorceChartPoint("Jun", 94), new ZoorceChartPoint("Jul", 92), new ZoorceChartPoint("Aug", 97), new ZoorceChartPoint("Sep", 96)) with { RenderAs = ZoorceChartSeriesKind.Line, Axis = ZoorceChartAxis.Secondary }
    };
    var radar = new[] { Series("Platform", new("Quality", 84), new("Security", 93), new("Speed", 72), new("Coverage", 88), new("Support", 79)), Series("Target", new("Quality", 80), new("Security", 88), new("Speed", 80), new("Coverage", 82), new("Support", 78)) };
    var radial = new[] { Series("Reliability", new ZoorceChartPoint("Current", 98)), Series("Coverage", new ZoorceChartPoint("Current", 82)), Series("Adoption", new ZoorceChartPoint("Current", 67)) };
    var calendar = new[] { Series("Deployments", Enumerable.Range(0, 28).Select(index => new ZoorceChartPoint($"Day {index + 1}", 14 + (index * 17) % 83, Timestamp: DateTimeOffset.UtcNow.Date.AddDays(-27 + index))).ToArray()) };
    var lollipops = new[] { Series("Lead time", new("Plan", 7), new("Build", 13), new("Verify", 9), new("Release", 18), new("Learn", 11)) };
    var slope = new[] { Series("Gateway", new("Before", 74), new("After", 92)), Series("Search", new("Before", 88), new("After", 79)), Series("Billing", new("Before", 61), new("After", 86)) };
    var candles = new[] { new ZoorceChartOhlcPoint("Mon", 82, 94, 76, 90), new("Tue", 90, 96, 83, 87), new("Wed", 87, 103, 85, 99), new("Thu", 99, 108, 92, 95), new("Fri", 95, 107, 91, 104) };
    var boxes = new[] { new ZoorceChartBoxPlotPoint("API", 28, 42, 51, 67, 88, new[] { 18m, 96m }), new("Search", 34, 49, 59, 73, 91), new("Checkout", 21, 38, 47, 62, 84, new[] { 99m }) };
    var treemap = new[] { new ZoorceChartTreemapItem("platform", "Platform", 42), new("data", "Data", 31), new("experience", "Experience", 18), new("security", "Security", 9) };
    var sankeyNodes = new[] { new ZoorceChartSankeyNode("events", "Events"), new("rules", "Rules"), new("alerts", "Alerts"), new("incidents", "Incidents") };
    var sankeyLinks = new[] { new ZoorceChartSankeyLink("events", "rules", 92), new("rules", "alerts", 61), new("rules", "incidents", 23), new("alerts", "incidents", 18) };
    var ganttStart = DateTimeOffset.UtcNow.Date;
    var gantt = new[] { new ZoorceChartGanttItem("design", "Design", ganttStart, ganttStart.AddDays(4), "Release", 100), new("build", "Build", ganttStart.AddDays(3), ganttStart.AddDays(9), "Release", 64), new("verify", "Verify", ganttStart.AddDays(8), ganttStart.AddDays(12), "Release", 18) };
}

<section class="z-chart-gallery-page">
    <div class="z-chart-gallery-intro" data-z-demo-chart-gallery>
        <div>
            <span class="z-section-kicker">Native SVG visualization system</span>
            <h1>Sharp data, no external charting runtime.</h1>
            <p>Every visual below is its own configurable component. Hover or focus data marks for details, and toggle any multi-series legend without changing the rest of the page.</p>
        </div>
        <div class="z-page-actions"><button class="z-button z-button-primary" type="button" data-z-demo-chart-update>Simulate data pulse</button><span class="z-card-caption" data-z-demo-chart-status aria-live="polite"></span></div>
    </div>

    <div class="z-chart-gallery">
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-trend", Title = "Product adoption", Summary = "Monthly adoption compared with target", Kind = ZoorceChartKind.Area, Size = ZoorceChartSize.Wide, ValueSuffix = "%", Curve = ZoorceChartCurve.Smooth, Series = adoption })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-stacked-area", Title = "HTTP ping times", Summary = "Stacked monitor timings over the selected window", Kind = ZoorceChartKind.Area, AreaMode = ZoorceChartAreaMode.Stacked, Size = ZoorceChartSize.Wide, ValueSuffix = " ms", Curve = ZoorceChartCurve.Monotone, Appearance = new ZoorceChartAppearanceOptions { Surface = ZoorceChartSurface.Bare }, Header = new ZoorceChartHeaderOptions { ShowMetric = false }, Series = stackedLatency })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-bars", Title = "Channel composition", Summary = "Acquisition channel composition", Kind = ZoorceChartKind.Bar, BarMode = ZoorceChartBarMode.Stacked100, ValueSuffix = "%", Series = channels })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-ranking", Title = "Service ranking", Summary = "Services ranked by response score", Kind = ZoorceChartKind.HorizontalBar, ValueSuffix = " ms", Series = ranking })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-donut", Title = "Portfolio health", Summary = "Health status distribution", Kind = ZoorceChartKind.Donut, ValueSuffix = "%", Series = distribution })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-gauge", Title = "Service objective", Summary = "Current service objective attainment", Kind = ZoorceChartKind.Gauge, ValueSuffix = "%", MinimumValue = 0, MaximumValue = 100, TargetValue = 99, ShowLegend = false, Series = gauge })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-sparkline", Title = "Quiet sparkline", Summary = "Compact adoption trend", Kind = ZoorceChartKind.Sparkline, Size = ZoorceChartSize.Compact, ValueSuffix = "%", ShowLegend = false, ShowAxes = false, ShowGrid = false, Series = new[] { adoption[0] } })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-funnel", Title = "Activation funnel", Summary = "Customer journey conversion stages", Kind = ZoorceChartKind.Funnel, ShowLegend = false, Series = funnel })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-heatmap", Title = "Usage intensity", Summary = "Activity by weekday and hour", Kind = ZoorceChartKind.Heatmap, ValueSuffix = " events", ShowLegend = false, Series = heatmap })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-scatter", Title = "Value correlation", Summary = "Usage and satisfaction correlation", Kind = ZoorceChartKind.Scatter, ValueSuffix = "%", Series = scatter })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-bubble", Title = "Account opportunity", Summary = "Account value, engagement and size", Kind = ZoorceChartKind.Bubble, ValueSuffix = "%", ShowLegend = false, Series = bubbles })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-bullet", Title = "Release confidence", Summary = "Release confidence against its target", Kind = ZoorceChartKind.Bullet, ValueSuffix = "%", MinimumValue = 0, MaximumValue = 100, TargetValue = 92, ShowLegend = false, Series = new[] { Series("Confidence", new ZoorceChartPoint("Current", 87)) } })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-histogram", Title = "Latency distribution", Summary = "Distribution of request latency", Kind = ZoorceChartKind.Histogram, ValueSuffix = " requests", ShowLegend = false, Series = histogram })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-waterfall", Title = "Revenue bridge", Summary = "Revenue changes that produce the period result", Kind = ZoorceChartKind.Waterfall, ValueSuffix = "k", ShowLegend = false, Series = waterfall })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-range", Title = "Forecast range", Summary = "Expected interval without invented extrema", Kind = ZoorceChartKind.RangeArea, Curve = ZoorceChartCurve.Monotone, ValueSuffix = "%", ShowLegend = false, Series = range })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-combo", Title = "Delivery throughput", Summary = "Bars and a secondary-axis service level", Kind = ZoorceChartKind.Combo, ValueSuffix = "%", Series = combo })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-radar", Title = "Platform scorecard", Summary = "Category comparison on a radial scale", Kind = ZoorceChartKind.Radar, ValueSuffix = "%", Series = radar })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-radial", Title = "Capability rings", Summary = "Several proportional outcomes", Kind = ZoorceChartKind.Radial, ValueSuffix = "%", Series = radial })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-calendar", Title = "Deployment calendar", Summary = "Daily deployment activity", Kind = ZoorceChartKind.CalendarHeatmap, ValueSuffix = " events", ShowLegend = false, Series = calendar })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-lollipop", Title = "Stage lead time", Summary = "Values with precise endpoints", Kind = ZoorceChartKind.Lollipop, ValueSuffix = " h", ShowLegend = false, Series = lollipops })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-slope", Title = "Release impact", Summary = "Before and after service scores", Kind = ZoorceChartKind.Slope, ValueSuffix = "%", Series = slope })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-candle", Title = "Latency movement", Summary = "Open high low close latency values", Kind = ZoorceChartKind.Candlestick, ValueSuffix = " ms", ShowLegend = false, OhlcPoints = candles })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-box", Title = "Response spread", Summary = "Quartiles and outliers by service", Kind = ZoorceChartKind.BoxPlot, ValueSuffix = " ms", ShowLegend = false, BoxPlotPoints = boxes })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-treemap", Title = "Investment mix", Summary = "Relative portfolio weight", Kind = ZoorceChartKind.Treemap, ShowLegend = false, TreemapItems = treemap })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-sankey", Title = "Signal routing", Summary = "Flow from events into incidents", Kind = ZoorceChartKind.Sankey, ShowLegend = false, SankeyNodes = sankeyNodes, SankeyLinks = sankeyLinks })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-gantt", Title = "Release plan", Summary = "Scheduled work and completion", Kind = ZoorceChartKind.Gantt, ShowLegend = false, GanttItems = gantt })
        @await Component.InvokeAsync("ZoorceChart", new ZoorceChartOptions { Id = "chart-bare", Title = "Embedded trend", Summary = "A host-owned chart surface", Kind = ZoorceChartKind.Area, Curve = ZoorceChartCurve.Monotone, ValueSuffix = "%", Appearance = new ZoorceChartAppearanceOptions { Surface = ZoorceChartSurface.Bare }, Header = new ZoorceChartHeaderOptions { ShowMetric = false }, Legend = new ZoorceChartLegendOptions { Visible = false }, Series = new[] { adoption[0] } })
    </div>
</section>

@section Scripts {
    <script src="/js/sample-demos.js" asp-append-version="true"></script>
}
